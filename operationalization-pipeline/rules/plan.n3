@prefix odrl:   <http://www.w3.org/ns/odrl/2/> .
@prefix dqvp:   <https://feed-upc.github.io/DQVP-position/dqvp.ttl#> .
@prefix dqv:    <http://www.w3.org/ns/dqv#> .
@prefix pc:     <https://feed-upc.github.io/DQVP-position/pc#> .
@prefix log:    <http://www.w3.org/2000/10/swap/log#> .
@prefix math:   <http://www.w3.org/2000/10/swap/math#> .
@prefix string: <http://www.w3.org/2000/10/swap/string#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .

# =============================================================================
# DQVP policy  ->  Policy Checker (technology-agnostic workflow).
#  * the PolicyChecker is a DISTINCT resource, pc:accordingTo the policy
#  * every operation/artifact has a stable skolem IRI minted via log:uri
#  * ONE shared Load feeds parallel per-check branches
#  * operations/artifacts are TYPED with pc: classes
#  * the skeleton is selected by the metric's pc:shape
#  * only NEUTRAL parameters live here — no engine syntax
# =============================================================================

# ---- local name of an IRI, or a plain string passed through -----------------
{ ?c dqvp:targetAttribute ?t . ?t log:rawType log:Literal . } => { ?c pc:col ?t } .
{ ?c dqvp:targetAttribute ?t . ?t log:uri ?u . ( ?u "^.*[/#]([^/#]+)$" ) string:scrape ?l . } => { ?c pc:col ?l } .
{ ?f dqvp:filterAttribute ?t . ?t log:rawType log:Literal . } => { ?f pc:fcol ?t } .
{ ?f dqvp:filterAttribute ?t . ?t log:uri ?u . ( ?u "^.*[/#]([^/#]+)$" ) string:scrape ?l . } => { ?f pc:fcol ?l } .
{ ?c a dqvp:DQConstraint ; rdfs:label ?id . } => { ?c pc:checkId ?id } .
{ ?c dqvp:comparedAttribute ?t . ?t log:rawType log:Literal . } => { ?c pc:col2 ?t } .
{ ?c dqvp:comparedAttribute ?t . ?t log:uri ?u . ( ?u "^.*[/#]([^/#]+)$" ) string:scrape ?l . } => { ?c pc:col2 ?l } .
{ ?c dqvp:groupBy ?t . ?t log:rawType log:Literal . } => { ?c pc:gcol ?t } .
{ ?c dqvp:groupBy ?t . ?t log:uri ?u . ( ?u "^.*[/#]([^/#]+)$" ) string:scrape ?l . } => { ?c pc:gcol ?l } .

# ---- Rule-type abstraction --------------------------------------------------
#   Quality conditions can be attached to any deontic rule, not only a
#   permission. A duty ("the provider is obliged to maintain 99% completeness")
#   is the framing that makes ODRL worth using over a schema file, so the
#   skeletons key on pc:hasRule rather than on odrl:permission.
{ ?pol a dqvp:QualityPolicy ; odrl:permission ?r . } => { ?pol pc:hasRule ?r . ?r pc:ruleType odrl:Permission } .
{ ?pol a dqvp:QualityPolicy ; odrl:duty ?r . }       => { ?pol pc:hasRule ?r . ?r pc:ruleType odrl:Duty } .
{ ?pol a dqvp:QualityPolicy ; odrl:obligation ?r . } => { ?pol pc:hasRule ?r . ?r pc:ruleType odrl:Obligation } .

#   Prohibitions are deliberately NOT compiled. A DQ constraint on a permission
#   or duty asserts a condition that must hold; on a prohibition the intended
#   polarity is ambiguous - "this metric must not exceed X" is already
#   expressible by inverting the operator, so a prohibition would either
#   duplicate that or mean the constraint must be VIOLATED. Flag it in the plan
#   rather than dropping it silently.
{ ?pol a dqvp:QualityPolicy ; odrl:prohibition ?r . ?r odrl:constraint ?c .
  ?c a dqvp:DQConstraint . }
=> { ?c pc:unsupportedRuleType odrl:Prohibition } .

# ---- Asset local name, used to mint one workflow per asset ------------------
{ ?r odrl:target ?asset . ?asset log:uri ?au .
  ( ?au "^.*[/#]([^/#]+)$" ) string:scrape ?al . }
=> { ?asset pc:localName ?al } .

# ---- P1  ONE PolicyChecker per policy, ONE Workflow per asset ---------------
#   The checker is the compiled form of the agreement and carries
#   pc:accordingTo. The workflow is the executable unit: it has a single Load
#   and a single Table, so it cannot span assets, and it is the artifact that
#   gets dispatched to wherever the asset lives.
{ ?pol a dqvp:QualityPolicy ; pc:hasRule ?r . ?r odrl:target ?asset .
  ?asset pc:localName ?al .
  ?pol log:uri ?ps .
  ( ?ps "/checker" )         string:concatenation ?cks . ?chk  log:uri ?cks .
  ( ?ps "/checker/wf/" ?al ) string:concatenation ?wfs . ?wf   log:uri ?wfs .
  ( ?wfs "/load" )           string:concatenation ?lds . ?load log:uri ?lds .
  ( ?wfs "/source" )         string:concatenation ?sgs . ?src  log:uri ?sgs .
  ( ?wfs "/table" )          string:concatenation ?tbs . ?tbl  log:uri ?tbs . }
=> { ?chk a pc:PolicyChecker ; pc:accordingTo ?pol ; pc:hasWorkflow ?wf .
     ?wf a pc:Workflow ; pc:onAsset ?asset ; pc:hasOp ?load .
     ?load a pc:Load ; pc:order 1 ; pc:input ?src ; pc:output ?tbl .
     ?src a pc:Dataset ; pc:ofAsset ?asset .
     ?tbl a pc:Table . } .

# ---- Data-format binding: copy the asset's format + locator onto the source --
{ ?src a pc:Dataset ; pc:ofAsset ?asset . ?asset pc:format ?f ; pc:locator ?l . }
=> { ?src pc:format ?f ; pc:locator ?l } .

# ---- P2  SCALAR-COLUMN branch: Filter -> Measure -> Compare -> Report -------
{ ?pol a dqvp:QualityPolicy ; pc:hasRule ?r . ?r odrl:target ?asset ; odrl:constraint ?c .
  ?asset pc:localName ?al .
  ?c a dqvp:DQConstraint ; odrl:leftOperand ?m ; pc:col ?col . ?m pc:shape pc:ScalarColumnShape .
  ?pol log:uri ?ps .
  ( ?ps "/checker/wf/" ?al ) string:concatenation ?wfs . ?wf  log:uri ?wfs .
  ( ?wfs "/table" )          string:concatenation ?tbs . ?tbl log:uri ?tbs .
  ?c log:uri ?cu .
  ( ?cu "/filter" )    string:concatenation ?fs  . ?flt  log:uri ?fs  .
  ( ?cu "/ftable" )    string:concatenation ?fts . ?ftbl log:uri ?fts .
  ( ?cu "/measure" )   string:concatenation ?ms  . ?meas log:uri ?ms  .
  ( ?cu "/mval" )      string:concatenation ?mvs . ?mval log:uri ?mvs .
  ( ?cu "/compare" )   string:concatenation ?cs  . ?cmp  log:uri ?cs  .
  ( ?cu "/verdict" )   string:concatenation ?vs  . ?vd   log:uri ?vs  .
  ( ?cu "/report" )    string:concatenation ?rs  . ?rep  log:uri ?rs  .
  ( ?cu "/reportdoc" ) string:concatenation ?rds . ?rdoc log:uri ?rds . }
=> { ?wf pc:hasOp ?flt, ?meas, ?cmp, ?rep .
     ?flt  a pc:Filter  ; pc:order 2 ; pc:forCheck ?c ; pc:input ?tbl  ; pc:output ?ftbl . ?ftbl a pc:Table .
     ?meas a pc:Measure ; pc:order 3 ; pc:forCheck ?c ; pc:metric ?m ; pc:input ?ftbl ; pc:output ?mval ;
           pc:parameter [ pc:name "column" ; pc:value ?col ] . ?mval a pc:MeasureValue .
     ?cmp  a pc:Compare ; pc:order 4 ; pc:forCheck ?c ; pc:input ?mval ; pc:output ?vd . ?vd a pc:Verdict .
     ?rep  a pc:Report  ; pc:order 5 ; pc:forCheck ?c ; pc:input ?vd ; pc:output ?rdoc . ?rdoc a pc:ReportDoc . } .

# ---- Compare parameters (operator symbols from config) ----------------------
{ ?cmp a pc:Compare ; pc:forCheck ?c . ?c odrl:operator ?o ; odrl:rightOperand ?thr .
  ?o pc:sqlSymbol ?sql ; pc:pySymbol ?py . }
=> { ?cmp pc:parameter [ pc:name "threshold" ; pc:value ?thr ] ,
                       [ pc:name "sqlOp" ; pc:value ?sql ] ,
                       [ pc:name "pyOp"  ; pc:value ?py  ] . } .

# ---- Derived neutral render-values on the Measure op ------------------------
#  mostly is computed for EVERY gteq (incl. threshold = 100 -> mostly = 1.0).
#  Guarded on pc:isPercentage: these render-values divide by or subtract from 100,
#  which is only meaningful for a metric whose value space IS a percentage. An
#  absolute metric such as dqvp:RowCount would otherwise acquire mostly = 4.0
#  from a threshold of 400.
#  Keyed on pc:metric rather than on the pc:Measure class: a scalar shape carries
#  the metric on its Measure, a row-predicate shape on the Aggregate that reduces
#  the mask. Typing these on Measure silently starved every row-predicate check
#  of its render-values.
{ ?op pc:metric ?m ; pc:forCheck ?c . ?c odrl:operator odrl:gteq ; odrl:rightOperand ?thr .
  ?m pc:isPercentage true . ( ?thr 100 ) math:quotient ?mm . }
=> { ?op pc:parameter [ pc:name "mostly" ; pc:value ?mm ] } .
{ ?op pc:metric ?m ; pc:forCheck ?c . ?c odrl:rightOperand ?thr .
  ?m pc:isPercentage true . ( 100 ?thr ) math:difference ?d . }
=> { ?op pc:parameter [ pc:name "complement" ; pc:value ?d ] } .

# ---- Reference resolution: Resolve -> CodeList feeds Measure ----------------
#   keyed on the typed contractual qualifier dqvp:referenceStandard.
{ ?meas a pc:Measure ; pc:forCheck ?c . ?wf pc:hasOp ?meas .
  ?c dqvp:referenceStandard ?std .
  ?c log:uri ?cu .
  ( ?cu "/resolve" ) string:concatenation ?rss . ?res   log:uri ?rss .
  ( ?cu "/codes" )   string:concatenation ?cls . ?codes log:uri ?cls . }
=> { ?wf pc:hasOp ?res .
     ?res a pc:Resolve ; pc:order 0 ; pc:forCheck ?c ; pc:output ?codes ;
          pc:parameter [ pc:name "referenceStandard" ; pc:value ?std ] . ?codes a pc:CodeList .
     ?meas pc:input ?codes ; pc:parameter [ pc:name "needsCodes" ; pc:value true ] . } .

# ---- Filter parameters (NEUTRAL only — engine syntax lives in the binder) ----
#  one filterValue parameter per value (sets are supported).
{ ?flt a pc:Filter ; pc:forCheck ?c . ?c dqvp:filter ?f . ?f pc:fcol ?fc ; dqvp:filterValue ?fv . }
=> { ?flt pc:parameter [ pc:name "filterColumn" ; pc:value ?fc ] ,
                       [ pc:name "filterValue"  ; pc:value ?fv ] . } .

#  propagate the filter operator (local name; defaults to eq in the binder).
{ ?flt a pc:Filter ; pc:forCheck ?c . ?c dqvp:filter ?f . ?f dqvp:filterOperator ?fo .
  ?fo log:uri ?ou . ( ?ou "^.*[/#]([^/#]+)$" ) string:scrape ?ol . }
=> { ?flt pc:parameter [ pc:name "filterOp" ; pc:value ?ol ] } .

# ---- P3  TABLE branch: Filter -> Measure(no column) -> Compare -> Report ----
#  A table-level metric has no dqvp:targetAttribute: it is a property of the
#  dataset, not of a column. Same skeleton as P2 minus the "column" parameter.
{ ?pol a dqvp:QualityPolicy ; pc:hasRule ?r . ?r odrl:target ?asset ; odrl:constraint ?c .
  ?asset pc:localName ?al .
  ?c a dqvp:DQConstraint ; odrl:leftOperand ?m . ?m pc:shape pc:TableShape .
  ?pol log:uri ?ps .
  ( ?ps "/checker/wf/" ?al ) string:concatenation ?wfs . ?wf  log:uri ?wfs .
  ( ?wfs "/table" )          string:concatenation ?tbs . ?tbl log:uri ?tbs .
  ?c log:uri ?cu .
  ( ?cu "/filter" )    string:concatenation ?fs  . ?flt  log:uri ?fs  .
  ( ?cu "/ftable" )    string:concatenation ?fts . ?ftbl log:uri ?fts .
  ( ?cu "/measure" )   string:concatenation ?ms  . ?meas log:uri ?ms  .
  ( ?cu "/mval" )      string:concatenation ?mvs . ?mval log:uri ?mvs .
  ( ?cu "/compare" )   string:concatenation ?cs  . ?cmp  log:uri ?cs  .
  ( ?cu "/verdict" )   string:concatenation ?vs  . ?vd   log:uri ?vs  .
  ( ?cu "/report" )    string:concatenation ?rs  . ?rep  log:uri ?rs  .
  ( ?cu "/reportdoc" ) string:concatenation ?rds . ?rdoc log:uri ?rds . }
=> { ?wf pc:hasOp ?flt, ?meas, ?cmp, ?rep .
     ?flt  a pc:Filter  ; pc:order 2 ; pc:forCheck ?c ; pc:input ?tbl  ; pc:output ?ftbl . ?ftbl a pc:Table .
     ?meas a pc:Measure ; pc:order 3 ; pc:forCheck ?c ; pc:metric ?m ; pc:input ?ftbl ; pc:output ?mval .
     ?mval a pc:MeasureValue .
     ?cmp  a pc:Compare ; pc:order 4 ; pc:forCheck ?c ; pc:input ?mval ; pc:output ?vd . ?vd a pc:Verdict .
     ?rep  a pc:Report  ; pc:order 5 ; pc:forCheck ?c ; pc:input ?vd ; pc:output ?rdoc . ?rdoc a pc:ReportDoc . } .

# ---- P4  PAIR-COLUMN branch: same skeleton, two column parameters ----------
#  Resolves the multi-attribute arity barrier: the Measure carries both the
#  target column and the compared column, so the engine template can relate them.
{ ?pol a dqvp:QualityPolicy ; pc:hasRule ?r . ?r odrl:target ?asset ; odrl:constraint ?c .
  ?asset pc:localName ?al .
  ?c a dqvp:DQConstraint ; odrl:leftOperand ?m ; pc:col ?col ; pc:col2 ?col2 .
  ?m pc:shape pc:PairColumnShape .
  ?pol log:uri ?ps .
  ( ?ps "/checker/wf/" ?al ) string:concatenation ?wfs . ?wf  log:uri ?wfs .
  ( ?wfs "/table" )          string:concatenation ?tbs . ?tbl log:uri ?tbs .
  ?c log:uri ?cu .
  ( ?cu "/filter" )    string:concatenation ?fs  . ?flt  log:uri ?fs  .
  ( ?cu "/ftable" )    string:concatenation ?fts . ?ftbl log:uri ?fts .
  ( ?cu "/measure" )   string:concatenation ?ms  . ?meas log:uri ?ms  .
  ( ?cu "/mval" )      string:concatenation ?mvs . ?mval log:uri ?mvs .
  ( ?cu "/compare" )   string:concatenation ?cs  . ?cmp  log:uri ?cs  .
  ( ?cu "/verdict" )   string:concatenation ?vs  . ?vd   log:uri ?vs  .
  ( ?cu "/report" )    string:concatenation ?rs  . ?rep  log:uri ?rs  .
  ( ?cu "/reportdoc" ) string:concatenation ?rds . ?rdoc log:uri ?rds . }
=> { ?wf pc:hasOp ?flt, ?meas, ?cmp, ?rep .
     ?flt  a pc:Filter  ; pc:order 2 ; pc:forCheck ?c ; pc:input ?tbl  ; pc:output ?ftbl . ?ftbl a pc:Table .
     ?meas a pc:Measure ; pc:order 3 ; pc:forCheck ?c ; pc:metric ?m ; pc:input ?ftbl ; pc:output ?mval ;
           pc:parameter [ pc:name "column"  ; pc:value ?col  ] ,
                        [ pc:name "column2" ; pc:value ?col2 ] . ?mval a pc:MeasureValue .
     ?cmp  a pc:Compare ; pc:order 4 ; pc:forCheck ?c ; pc:input ?mval ; pc:output ?vd . ?vd a pc:Verdict .
     ?rep  a pc:Report  ; pc:order 5 ; pc:forCheck ?c ; pc:input ?vd ; pc:output ?rdoc . ?rdoc a pc:ReportDoc . } .

# ---- Grouping parameter (orthogonal to shape, like the row filter) ---------
#  Universal quantification over the partitions induced by dqvp:groupBy.
{ ?meas a pc:Measure ; pc:forCheck ?c . ?c pc:gcol ?gc . }
=> { ?meas pc:parameter [ pc:name "groupColumn" ; pc:value ?gc ] } .

# ---- Record-level operator, projected to its local name ---------------------
{ ?c dqvp:rowOperator ?o . ?o log:uri ?ou . ( ?ou "^.*[/#]([^/#]+)$" ) string:scrape ?ol . }
=> { ?c pc:rowOp ?ol } .

# ---- P5  ROW-PREDICATE branch ----------------------------------------------
#   Filter -> RowPredicate -> Aggregate -> Compare -> Report
#
#   The record-level test and the aggregation that consumes it are separate
#   operations. Folding them together, as the earlier pairwise metric did, has
#   three costs: the record-level comparison can only be whatever the metric
#   froze in, the aggregation is implied by the metric's name rather than stated,
#   and dqvp:groupBy has to collapse to a worst-case trick instead of simply
#   aggregating twice.
{ ?pol a dqvp:QualityPolicy ; pc:hasRule ?r . ?r odrl:target ?asset ; odrl:constraint ?c .
  ?asset pc:localName ?al .
  ?c a dqvp:DQConstraint ; odrl:leftOperand ?m ; pc:col ?col .
  ?m pc:shape pc:RowPredicateShape ; pc:aggregation ?agg .
  ?pol log:uri ?ps .
  ( ?ps "/checker/wf/" ?al ) string:concatenation ?wfs . ?wf  log:uri ?wfs .
  ( ?wfs "/table" )          string:concatenation ?tbs . ?tbl log:uri ?tbs .
  ?c log:uri ?cu .
  ( ?cu "/filter" )    string:concatenation ?fs  . ?flt  log:uri ?fs  .
  ( ?cu "/ftable" )    string:concatenation ?fts . ?ftbl log:uri ?fts .
  ( ?cu "/predicate" ) string:concatenation ?rps . ?rp   log:uri ?rps .
  ( ?cu "/mask" )      string:concatenation ?mks . ?mask log:uri ?mks .
  ( ?cu "/aggregate" ) string:concatenation ?ags . ?ag   log:uri ?ags .
  ( ?cu "/mval" )      string:concatenation ?mvs . ?mval log:uri ?mvs .
  ( ?cu "/compare" )   string:concatenation ?cs  . ?cmp  log:uri ?cs  .
  ( ?cu "/verdict" )   string:concatenation ?vs  . ?vd   log:uri ?vs  .
  ( ?cu "/report" )    string:concatenation ?rs  . ?rep  log:uri ?rs  .
  ( ?cu "/reportdoc" ) string:concatenation ?rds . ?rdoc log:uri ?rds . }
=> { ?wf pc:hasOp ?flt, ?rp, ?ag, ?cmp, ?rep .
     ?flt a pc:Filter ; pc:order 2 ; pc:forCheck ?c ; pc:input ?tbl ; pc:output ?ftbl .
     ?ftbl a pc:Table .
     ?rp  a pc:RowPredicate ; pc:order 3 ; pc:forCheck ?c ; pc:input ?ftbl ; pc:output ?mask ;
          pc:parameter [ pc:name "column" ; pc:value ?col ] . ?mask a pc:Mask .
     ?ag  a pc:Aggregate ; pc:order 4 ; pc:forCheck ?c ; pc:metric ?m ;
          pc:input ?mask ; pc:output ?mval ;
          pc:parameter [ pc:name "aggregation" ; pc:value ?agg ] . ?mval a pc:MeasureValue .
     ?cmp a pc:Compare ; pc:order 5 ; pc:forCheck ?c ; pc:input ?mval ; pc:output ?vd .
     ?vd a pc:Verdict .
     ?rep a pc:Report ; pc:order 6 ; pc:forCheck ?c ; pc:input ?vd ; pc:output ?rdoc .
     ?rdoc a pc:ReportDoc . } .

# ---- RowPredicate parameters: the compared attribute and the record operator -
{ ?rp a pc:RowPredicate ; pc:forCheck ?c . ?c pc:col2 ?col2 . }
=> { ?rp pc:parameter [ pc:name "column2" ; pc:value ?col2 ] } .
{ ?rp a pc:RowPredicate ; pc:forCheck ?c . ?c pc:rowOp ?ro . }
=> { ?rp pc:parameter [ pc:name "rowOp" ; pc:value ?ro ] } .
{ ?rp a pc:RowPredicate ; pc:forCheck ?c . ?c dqvp:rowExpression ?ex . }
=> { ?rp pc:parameter [ pc:name "rowExpression" ; pc:value ?ex ] } .

# ---- Record-level operator symbols, from the same table as the threshold's ---
{ ?rp a pc:RowPredicate ; pc:forCheck ?c . ?c dqvp:rowOperator ?o .
  ?o pc:sqlSymbol ?s ; pc:pySymbol ?p . }
=> { ?rp pc:parameter [ pc:name "rowSqlOp" ; pc:value ?s ] ,
                      [ pc:name "rowPyOp"  ; pc:value ?p ] } .

# ---- P6  SCHEMA branch: Describe -> Measure -> Compare -> Report -------------
#   A schema metric measures the shape of the asset, not its records, so the
#   branch has no Filter: a row predicate over a schema is meaningless. Describe
#   makes the derivation explicit rather than letting Measure reach past the
#   Table for something the plan never named.
{ ?pol a dqvp:QualityPolicy ; pc:hasRule ?r . ?r odrl:target ?asset ; odrl:constraint ?c .
  ?asset pc:localName ?al .
  ?c a dqvp:DQConstraint ; odrl:leftOperand ?m . ?m pc:shape pc:SchemaShape .
  ?pol log:uri ?ps .
  ( ?ps "/checker/wf/" ?al ) string:concatenation ?wfs . ?wf  log:uri ?wfs .
  ( ?wfs "/table" )          string:concatenation ?tbs . ?tbl log:uri ?tbs .
  ?c log:uri ?cu .
  ( ?cu "/describe" )  string:concatenation ?ds  . ?desc log:uri ?ds  .
  ( ?cu "/schema" )    string:concatenation ?scs . ?sch  log:uri ?scs .
  ( ?cu "/measure" )   string:concatenation ?ms  . ?meas log:uri ?ms  .
  ( ?cu "/mval" )      string:concatenation ?mvs . ?mval log:uri ?mvs .
  ( ?cu "/compare" )   string:concatenation ?cs  . ?cmp  log:uri ?cs  .
  ( ?cu "/verdict" )   string:concatenation ?vs  . ?vd   log:uri ?vs  .
  ( ?cu "/report" )    string:concatenation ?rs  . ?rep  log:uri ?rs  .
  ( ?cu "/reportdoc" ) string:concatenation ?rds . ?rdoc log:uri ?rds . }
=> { ?wf pc:hasOp ?desc, ?meas, ?cmp, ?rep .
     ?desc a pc:Describe ; pc:order 2 ; pc:forCheck ?c ; pc:input ?tbl ; pc:output ?sch .
     ?sch a pc:Schema .
     ?meas a pc:Measure ; pc:order 3 ; pc:forCheck ?c ; pc:metric ?m ;
           pc:input ?sch ; pc:output ?mval . ?mval a pc:MeasureValue .
     ?cmp a pc:Compare ; pc:order 4 ; pc:forCheck ?c ; pc:input ?mval ; pc:output ?vd .
     ?vd a pc:Verdict .
     ?rep a pc:Report ; pc:order 5 ; pc:forCheck ?c ; pc:input ?vd ; pc:output ?rdoc .
     ?rdoc a pc:ReportDoc . } .

# ---- Schema-metric parameters ----------------------------------------------
#  one expectedAttribute parameter per expected attribute (the set is the subject)
{ ?meas a pc:Measure ; pc:forCheck ?c . ?c dqvp:expectedAttribute ?a .
  ?a log:uri ?au . ( ?au "^.*[/#]([^/#]+)$" ) string:scrape ?al . }
=> { ?meas pc:parameter [ pc:name "expectedAttribute" ; pc:value ?al ] } .
{ ?meas a pc:Measure ; pc:forCheck ?c . ?c dqvp:expectedDatatype ?d .
  ?d log:uri ?du . ( ?du "^.*[/#]([^/#]+)$" ) string:scrape ?dl . }
=> { ?meas pc:parameter [ pc:name "expectedDatatype" ; pc:value ?dl ] } .
{ ?meas a pc:Measure ; pc:forCheck ?c . ?c a dqvp:DQConstraint ; pc:col ?col .
  ?c odrl:leftOperand ?m . ?m pc:shape pc:SchemaShape . }
=> { ?meas pc:parameter [ pc:name "column" ; pc:value ?col ] } .
