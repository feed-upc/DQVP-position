@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix dqvp: <https://feed-upc.github.io/DQVP-position/dqvp.ttl#> .
@prefix dqv:  <http://www.w3.org/ns/dqv#> .
@prefix pc:   <https://feed-upc.github.io/DQVP-position/pc#> .

# Data-driven config consumed by the generic rules.

# Operator -> symbolic forms (add an operator => add a row, not a rule).
odrl:gteq pc:sqlSymbol ">=" ; pc:pySymbol ">=" .
odrl:lteq pc:sqlSymbol "<=" ; pc:pySymbol "<=" .
odrl:eq   pc:sqlSymbol "="  ; pc:pySymbol "==" .
odrl:gt   pc:sqlSymbol ">"  ; pc:pySymbol ">"  .
odrl:lt   pc:sqlSymbol "<"  ; pc:pySymbol "<"  .
odrl:neq  pc:sqlSymbol "<>" ; pc:pySymbol "!=" .

# Metric -> workflow shape (the skeleton rule keys on this; adding a metric of an
# existing shape needs no rule, only a template).
dqvp:NonNullRate          pc:shape pc:ScalarColumnShape .
dqvp:NullRate             pc:shape pc:ScalarColumnShape .
dqvp:ReferenceConformance pc:shape pc:ScalarColumnShape .

# ---- v0.3 metrics -----------------------------------------------------------
dqvp:UniqueRate             pc:shape pc:ScalarColumnShape .
dqvp:AttributeAgreementRate pc:shape pc:PairColumnShape .
dqvp:RowCount               pc:shape pc:TableShape .

# Percentage-valued metrics. Only these get the derived percentage render values
# (mostly, complement). dqvp:RowCount is an absolute count, so deriving
# mostly = 400/100 = 4.0 from its threshold would be meaningless - the derived
# rules previously fired for every metric regardless of its value space.
dqvp:NonNullRate            pc:isPercentage true .
dqvp:NullRate               pc:isPercentage true .
dqvp:ReferenceConformance   pc:isPercentage true .
dqvp:UniqueRate             pc:isPercentage true .
dqvp:AttributeAgreementRate pc:isPercentage true .

# ---- v0.4 row-predicate metrics ---------------------------------------------
# The aggregation is declared here rather than implied by the metric's name, so
# a new record-level test is a config row plus templates, not a new rule.
dqvp:RowComparison    pc:shape pc:RowPredicateShape ; pc:aggregation "rate" ; pc:isPercentage true .
dqvp:RowExpressionRate pc:shape pc:RowPredicateShape ; pc:aggregation "rate" ; pc:isPercentage true .

# Record-level operators. Reusing the same symbol table as the threshold
# comparison: an operator is an operator, whichever level it is applied at.

# ---- v0.5 schema metrics ----------------------------------------------------
# Measured over the schema, so no row filter applies. Both report on 0-100 so
# they share the threshold machinery rather than needing boolean comparison.
dqvp:SchemaConformance        pc:shape pc:SchemaShape ; pc:isPercentage true .
dqvp:AttributeTypeConformance pc:shape pc:SchemaShape ; pc:isPercentage true .

# ---- v0.7 cross-asset metric ------------------------------------------------
dqvp:ReferentialIntegrity pc:shape pc:CrossAssetShape ; pc:isPercentage true .

# ---- v0.8 distribution-shaped metrics, reduced to scalars -------------------
# Quantile and Correlation report in their own units, not as percentages, so the
# derived percentage render-values must not fire for them.
dqvp:Quantile         pc:shape pc:ScalarColumnShape .
dqvp:ModeShare        pc:shape pc:ScalarColumnShape ; pc:isPercentage true .
dqvp:ExplicitNullRate pc:shape pc:ScalarColumnShape ; pc:isPercentage true .
dqvp:Correlation      pc:shape pc:PairColumnShape .
