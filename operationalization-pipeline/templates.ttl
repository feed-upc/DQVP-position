@prefix tmpl: <https://feed-upc.github.io/DQVP-position/tmpl#> .
@prefix dqvp: <https://feed-upc.github.io/DQVP-position/dqvp.ttl#> .

# Code templates as graph data (Jinja). The plan stays technology-agnostic;
# templates own engine syntax. The filter clause is computed once by the binder
# (honouring operator + value sets) and injected as {{gxFilter}} /
# {{sqlFilter}} / {{sodaFilter}}. One generic binder renders any (engine, metric).

#### Great Expectations ####
tmpl:gx_nn tmpl:engine "gx" ; tmpl:metric dqvp:NonNullRate ;
  tmpl:body "validator.expect_column_values_to_not_be_null(column=\"{{column}}\", mostly={{mostly}}{{gxFilter}})" .
tmpl:gx_rc tmpl:engine "gx" ; tmpl:metric dqvp:ReferenceConformance ;
  tmpl:body "validator.expect_column_values_to_be_in_set(column=\"{{column}}\", value_set=CODE_LIST, mostly={{mostly}}{{gxFilter}})" .
tmpl:gx_nr tmpl:engine "gx" ; tmpl:metric dqvp:NullRate ;
  tmpl:body "validator.expect_column_values_to_be_null(column=\"{{column}}\"{{gxFilter}})" .

#### dbt singular tests ({% raw %} guards dbt's own {{ source }}) ####
tmpl:dbt_nn tmpl:engine "dbt" ; tmpl:metric dqvp:NonNullRate ;
  tmpl:body "-- {{checkId}}\nwith m as (select 100.0*count(\"{{column}}\")/nullif(count(*),0) as r from {% raw %}{{ source('ehds','patient_summary') }}{% endraw %}{{sqlFilter}})\nselect r from m where not (r {{sqlOp}} {{threshold}})" .
tmpl:dbt_rc tmpl:engine "dbt" ; tmpl:metric dqvp:ReferenceConformance ;
  tmpl:body "-- {{checkId}}\nwith m as (select 100.0*count(*) filter (where \"{{column}}\" in (select code from codes))/nullif(count(\"{{column}}\"),0) as r from {% raw %}{{ source('ehds','patient_summary') }}{% endraw %}{{sqlFilter}})\nselect r from m where not (r {{sqlOp}} {{threshold}})" .
tmpl:dbt_nr tmpl:engine "dbt" ; tmpl:metric dqvp:NullRate ;
  tmpl:body "-- {{checkId}}\nwith m as (select 100.0*(count(*)-count(\"{{column}}\"))/nullif(count(*),0) as r from {% raw %}{{ source('ehds','patient_summary') }}{% endraw %}{{sqlFilter}})\nselect r from m where not (r {{sqlOp}} {{threshold}})" .

#### Soda / SodaCL ####
tmpl:soda_nn tmpl:engine "sodacl" ; tmpl:metric dqvp:NonNullRate ;
  tmpl:body "  - missing_percent({{column}}) <= {{complement}}:\n      name: {{checkId}}{{sodaFilter}}" .
tmpl:soda_rc tmpl:engine "sodacl" ; tmpl:metric dqvp:ReferenceConformance ;
  tmpl:body "  - invalid_percent({{column}}) <= {{complement}}:\n      name: {{checkId}}\n      valid values: __CODES__{{sodaFilter}}" .
tmpl:soda_nr tmpl:engine "sodacl" ; tmpl:metric dqvp:NullRate ;
  tmpl:body "  - missing_percent({{column}}) {{sqlOp}} {{threshold}}:\n      name: {{checkId}}{{sodaFilter}}" .

#### PyDeequ (illustrative) ####
tmpl:deequ_nn tmpl:engine "deequ" ; tmpl:metric dqvp:NonNullRate ;
  tmpl:body "    .hasCompleteness(\"{{column}}\", lambda x: x {{pyOp}} {{mostly}})  # {{checkId}}{{deequNote}}" .
tmpl:deequ_rc tmpl:engine "deequ" ; tmpl:metric dqvp:ReferenceConformance ;
  tmpl:body "    .isContainedIn(\"{{column}}\", CODE_LIST)  # {{checkId}}{{deequNote}}" .
tmpl:deequ_nr tmpl:engine "deequ" ; tmpl:metric dqvp:NullRate ;
  tmpl:body "    .hasCompleteness(\"{{column}}\", lambda x: x == 0.0)  # {{checkId}}{{deequNote}}" .

# =============================================================================
# LOAD templates — the data-access code, selected per (engine, FORMAT).
# This is the format dimension (after Hmimou et al.'s forType / technology aspect):
# only the Load operation's code depends on the data format; the check code above
# is format-agnostic because it runs over the loaded table.
# =============================================================================
tmpl:load_gx_csv     tmpl:loadEngine "gx"     ; tmpl:loadFormat "csv"     ; tmpl:loadBody "pd.read_csv('{{locator}}')" .
tmpl:load_gx_json    tmpl:loadEngine "gx"     ; tmpl:loadFormat "json"    ; tmpl:loadBody "pd.read_json('{{locator}}')" .
tmpl:load_gx_parquet tmpl:loadEngine "gx"     ; tmpl:loadFormat "parquet" ; tmpl:loadBody "pd.read_parquet('{{locator}}')" .

tmpl:load_duck_csv     tmpl:loadEngine "duckdb" ; tmpl:loadFormat "csv"     ; tmpl:loadBody "read_csv_auto('{{locator}}')" .
tmpl:load_duck_json    tmpl:loadEngine "duckdb" ; tmpl:loadFormat "json"    ; tmpl:loadBody "read_json_auto('{{locator}}')" .
tmpl:load_duck_parquet tmpl:loadEngine "duckdb" ; tmpl:loadFormat "parquet" ; tmpl:loadBody "read_parquet('{{locator}}')" .

tmpl:load_dbt_csv  tmpl:loadEngine "dbt" ; tmpl:loadFormat "csv"  ; tmpl:loadBody "# dbt source (dbt-duckdb): external_location: read_csv_auto('{{locator}}')" .
tmpl:load_dbt_json tmpl:loadEngine "dbt" ; tmpl:loadFormat "json" ; tmpl:loadBody "# dbt source (dbt-duckdb): external_location: read_json_auto('{{locator}}')" .
tmpl:load_dbt_parquet tmpl:loadEngine "dbt" ; tmpl:loadFormat "parquet" ; tmpl:loadBody "# dbt source (dbt-duckdb): external_location: read_parquet('{{locator}}')" .
