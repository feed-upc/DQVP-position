@prefix tmpl: <https://feed-upc.github.io/DQVP-position/tmpl#> .
@prefix dqvp: <https://feed-upc.github.io/DQVP-position/dqvp.ttl#> .

# Code templates as graph data (Jinja). The plan stays technology-agnostic;
# templates own engine syntax. The filter clause is computed once by the binder
# (honouring operator + value sets) and injected as {{gxFilter}} /
# {{sqlFilter}} / {{sodaFilter}}. One generic binder renders any (engine, metric).

#### Great Expectations ####
tmpl:gx_nn tmpl:engine "gx" ; tmpl:metric dqvp:NonNullRate ;
  tmpl:body "validator.expect_column_values_to_not_be_null(column=\"{{column}}\", mostly={{mostly}}{{gxFilter}}){% if groupColumn %}  # NOT EXPRESSIBLE: per-group evaluation over {{groupColumn}}; this checks the aggregate{% endif %}" .
tmpl:gx_rc tmpl:engine "gx" ; tmpl:metric dqvp:ReferenceConformance ;
  tmpl:body "validator.expect_column_values_to_be_in_set(column=\"{{column}}\", value_set=CODE_LIST, mostly={{mostly}}{{gxFilter}})" .
tmpl:gx_nr tmpl:engine "gx" ; tmpl:metric dqvp:NullRate ;
  tmpl:body "validator.expect_column_values_to_be_null(column=\"{{column}}\"{{gxFilter}})" .

#### dbt singular tests ({% raw %} guards dbt's own {{ source }}) ####
tmpl:dbt_nn tmpl:engine "dbt" ; tmpl:metric dqvp:NonNullRate ;
  tmpl:body "-- {{checkId}}\nwith m as (select {% if groupColumn %}\"{{groupColumn}}\" as g, {% endif %}100.0*count(\"{{column}}\")/nullif(count(*),0) as r from {{dbtSource}}{{sqlFilter}}{% if groupColumn %} group by \"{{groupColumn}}\"{% endif %})\nselect {% if groupColumn %}g, {% endif %}r from m where not (r {{sqlOp}} {{threshold}})" .
tmpl:dbt_rc tmpl:engine "dbt" ; tmpl:metric dqvp:ReferenceConformance ;
  tmpl:body "-- {{checkId}}\nwith m as (select 100.0*count(*) filter (where \"{{column}}\" in (select code from codes))/nullif(count(\"{{column}}\"),0) as r from {{dbtSource}}{{sqlFilter}})\nselect r from m where not (r {{sqlOp}} {{threshold}})" .
tmpl:dbt_nr tmpl:engine "dbt" ; tmpl:metric dqvp:NullRate ;
  tmpl:body "-- {{checkId}}\nwith m as (select 100.0*(count(*)-count(\"{{column}}\"))/nullif(count(*),0) as r from {{dbtSource}}{{sqlFilter}})\nselect r from m where not (r {{sqlOp}} {{threshold}})" .

#### Soda / SodaCL ####
tmpl:soda_nn tmpl:engine "sodacl" ; tmpl:metric dqvp:NonNullRate ;
  tmpl:body "  - missing_percent({{column}}) <= {{complement}}:\n      name: {{checkId}}{{sodaFilter}}{% if groupColumn %}  # NOT EXPRESSIBLE: per-group evaluation over {{groupColumn}}; this checks the aggregate{% endif %}" .
tmpl:soda_rc tmpl:engine "sodacl" ; tmpl:metric dqvp:ReferenceConformance ;
  tmpl:body "  - invalid_percent({{column}}) <= {{complement}}:\n      name: {{checkId}}\n      valid values: __CODES__{{sodaFilter}}" .
tmpl:soda_nr tmpl:engine "sodacl" ; tmpl:metric dqvp:NullRate ;
  tmpl:body "  - missing_percent({{column}}) {{sqlOp}} {{threshold}}:\n      name: {{checkId}}{{sodaFilter}}" .

#### PyDeequ (illustrative) ####
tmpl:deequ_nn tmpl:engine "deequ" ; tmpl:metric dqvp:NonNullRate ;
  tmpl:body "    .hasCompleteness(\"{{column}}\", lambda x: x {{pyOp}} {{mostly}})  # {{checkId}}{{deequNote}}{% if groupColumn %}  # NOT EXPRESSIBLE: per-group evaluation over {{groupColumn}}; this checks the aggregate{% endif %}" .
tmpl:deequ_rc tmpl:engine "deequ" ; tmpl:metric dqvp:ReferenceConformance ;
  tmpl:body "    .isContainedIn(\"{{column}}\", CODE_LIST)  # {{checkId}}{{deequNote}}" .
tmpl:deequ_nr tmpl:engine "deequ" ; tmpl:metric dqvp:NullRate ;
  tmpl:body "    .hasCompleteness(\"{{column}}\", lambda x: x == 0.0)  # {{checkId}}{{deequNote}}" .

# =============================================================================
# LOAD templates — the data-access code, selected per (engine, FORMAT).
# This is the format dimension (after Hmimou et al.'s forType / technology aspect):
# only the Load operation's code depends on the data format; the check code above
# is format-agnostic because it runs over the loaded table.
# =============================================================================
tmpl:load_gx_csv     tmpl:loadEngine "gx"     ; tmpl:loadFormat "csv"     ; tmpl:loadBody "pd.read_csv('{{locator}}')" .
tmpl:load_gx_json    tmpl:loadEngine "gx"     ; tmpl:loadFormat "json"    ; tmpl:loadBody "pd.read_json('{{locator}}')" .
tmpl:load_gx_parquet tmpl:loadEngine "gx"     ; tmpl:loadFormat "parquet" ; tmpl:loadBody "pd.read_parquet('{{locator}}')" .

tmpl:load_duck_csv     tmpl:loadEngine "duckdb" ; tmpl:loadFormat "csv"     ; tmpl:loadBody "read_csv_auto('{{locator}}')" .
tmpl:load_duck_json    tmpl:loadEngine "duckdb" ; tmpl:loadFormat "json"    ; tmpl:loadBody "read_json_auto('{{locator}}')" .
tmpl:load_duck_parquet tmpl:loadEngine "duckdb" ; tmpl:loadFormat "parquet" ; tmpl:loadBody "read_parquet('{{locator}}')" .

tmpl:load_dbt_csv  tmpl:loadEngine "dbt" ; tmpl:loadFormat "csv"  ; tmpl:loadBody "# dbt source (dbt-duckdb): external_location: read_csv_auto('{{locator}}')" .
tmpl:load_dbt_json tmpl:loadEngine "dbt" ; tmpl:loadFormat "json" ; tmpl:loadBody "# dbt source (dbt-duckdb): external_location: read_json_auto('{{locator}}')" .
tmpl:load_dbt_parquet tmpl:loadEngine "dbt" ; tmpl:loadFormat "parquet" ; tmpl:loadBody "# dbt source (dbt-duckdb): external_location: read_parquet('{{locator}}')" .

# =============================================================================
# v0.3 metrics. Grouping ({{groupColumn}}) is handled inside the template with a
# Jinja conditional rather than by a new binder function, so support for it is
# per-(engine, metric) data. Engines with no native per-group evaluation emit an
# explicit note rather than silently checking the aggregate instead.
# =============================================================================

#### UniqueRate ####
tmpl:gx_uq tmpl:engine "gx" ; tmpl:metric dqvp:UniqueRate ;
  tmpl:body "validator.expect_column_values_to_be_unique(column=\"{{column}}\", mostly={{mostly}}{{gxFilter}})" .
tmpl:dbt_uq tmpl:engine "dbt" ; tmpl:metric dqvp:UniqueRate ;
  tmpl:body "-- {{checkId}}\nwith m as (select 100.0*count(distinct \"{{column}}\")/nullif(count(\"{{column}}\"),0) as r from {{dbtSource}}{{sqlFilter}})\nselect r from m where not (r {{sqlOp}} {{threshold}})" .
tmpl:soda_uq tmpl:engine "sodacl" ; tmpl:metric dqvp:UniqueRate ;
  tmpl:body "  - duplicate_percent({{column}}) <= {{complement}}:\n      name: {{checkId}}{{sodaFilter}}" .
tmpl:deequ_uq tmpl:engine "deequ" ; tmpl:metric dqvp:UniqueRate ;
  tmpl:body "    .hasUniqueness(\"{{column}}\", lambda x: x {{pyOp}} {{mostly}})  # {{checkId}}{{deequNote}}" .

#### RowCount — table level, absolute threshold (no column, no percentage) ####
tmpl:gx_rc2 tmpl:engine "gx" ; tmpl:metric dqvp:RowCount ;
  tmpl:body "validator.expect_table_row_count_to_be_between(min_value={{threshold}})" .
tmpl:dbt_rc2 tmpl:engine "dbt" ; tmpl:metric dqvp:RowCount ;
  tmpl:body "-- {{checkId}}\nwith m as (select count(*) as r from {{dbtSource}}{{sqlFilter}})\nselect r from m where not (r {{sqlOp}} {{threshold}})" .
tmpl:soda_rc2 tmpl:engine "sodacl" ; tmpl:metric dqvp:RowCount ;
  tmpl:body "  - row_count {{sqlOp}} {{threshold}}:\n      name: {{checkId}}{{sodaFilter}}" .
tmpl:deequ_rc2 tmpl:engine "deequ" ; tmpl:metric dqvp:RowCount ;
  tmpl:body "    .hasSize(lambda x: x {{pyOp}} {{threshold}})  # {{checkId}}{{deequNote}}" .

#### AttributeAgreementRate — relates two columns of the same record ####
tmpl:gx_ag tmpl:engine "gx" ; tmpl:metric dqvp:AttributeAgreementRate ;
  tmpl:body "validator.expect_column_pair_values_to_be_equal(column_A=\"{{column}}\", column_B=\"{{column2}}\", mostly={{mostly}}{{gxFilter}})" .
tmpl:dbt_ag tmpl:engine "dbt" ; tmpl:metric dqvp:AttributeAgreementRate ;
  tmpl:body "-- {{checkId}}\nwith m as (select {% if groupColumn %}\"{{groupColumn}}\" as g, {% endif %}100.0*count(*) filter (where \"{{column}}\" = \"{{column2}}\")/nullif(count(*),0) as r from {{dbtSource}}{{sqlFilter}}{% if groupColumn %} group by \"{{groupColumn}}\"{% endif %})\nselect {% if groupColumn %}g, {% endif %}r from m where not (r {{sqlOp}} {{threshold}})" .
tmpl:soda_ag tmpl:engine "sodacl" ; tmpl:metric dqvp:AttributeAgreementRate ;
  tmpl:body "  - agreement_{{checkId}} >= {{threshold}}:\n      name: {{checkId}}\n      agreement_{{checkId}} query: |\n        SELECT 100.0*COUNT(*) FILTER (WHERE \"{{column}}\" = \"{{column2}}\")/NULLIF(COUNT(*),0) FROM {{sourceTable}}" .
tmpl:deequ_ag tmpl:engine "deequ" ; tmpl:metric dqvp:AttributeAgreementRate ;
  tmpl:body "    .satisfies(\"{{column}} = {{column2}}\", \"{{checkId}}\", lambda x: x {{pyOp}} {{mostly}})  # {{checkId}}{{deequNote}}" .

# =============================================================================
# v0.4 row-predicate metrics. The record-level operator arrives as both a local
# name ({{rowOp}}) and a symbol ({{rowSqlOp}}); engines that express only some
# comparisons dispatch on the name and refuse the rest, rather than emitting a
# check that looks right and tests something else.
# =============================================================================

#### RowComparison — target OP compared, per record, then a rate ####
tmpl:dbt_rowcmp tmpl:engine "dbt" ; tmpl:metric dqvp:RowComparison ;
  tmpl:body "-- {{checkId}}\nwith m as (select {% if groupColumn %}\"{{groupColumn}}\" as g, {% endif %}100.0*count(*) filter (where \"{{column}}\" {{rowSqlOp}} \"{{column2}}\")/nullif(count(*) filter (where \"{{column}}\" is not null and \"{{column2}}\" is not null),0) as r from {{dbtSource}}{{sqlFilter}}{% if groupColumn %} group by \"{{groupColumn}}\"{% endif %})\nselect {% if groupColumn %}g, {% endif %}r from m where not (r {{sqlOp}} {{threshold}})" .

tmpl:soda_rowcmp tmpl:engine "sodacl" ; tmpl:metric dqvp:RowComparison ;
  tmpl:body "  - rowcmp_{{checkId}} {{sqlOp}} {{threshold}}:\n      name: {{checkId}}\n      rowcmp_{{checkId}} query: |\n        SELECT 100.0*COUNT(*) FILTER (WHERE \"{{column}}\" {{rowSqlOp}} \"{{column2}}\")/NULLIF(COUNT(*) FILTER (WHERE \"{{column}}\" IS NOT NULL AND \"{{column2}}\" IS NOT NULL),0) FROM {{sourceTable}}" .

tmpl:deequ_rowcmp tmpl:engine "deequ" ; tmpl:metric dqvp:RowComparison ;
  tmpl:body "    .satisfies(\"{{column}} {{rowSqlOp}} {{column2}}\", \"{{checkId}}\", lambda x: x {{pyOp}} {{mostly}})  # {{checkId}}{{deequNote}}" .

# Great Expectations has a pair expectation for equality and for A-greater-than-B
# (with or_equal). Less-than is the same expectation with the columns swapped.
# There is no pair inequality expectation, so neq is refused.
tmpl:gx_rowcmp tmpl:engine "gx" ; tmpl:metric dqvp:RowComparison ;
  tmpl:body "{% if rowOp == 'eq' %}validator.expect_column_pair_values_to_be_equal(column_A=\"{{column}}\", column_B=\"{{column2}}\", mostly={{mostly}}{{gxFilter}}){% elif rowOp in ['gt','gteq'] %}validator.expect_column_pair_values_a_to_be_greater_than_b(column_A=\"{{column}}\", column_B=\"{{column2}}\", or_equal={{ 'True' if rowOp == 'gteq' else 'False' }}, mostly={{mostly}}{{gxFilter}}){% elif rowOp in ['lt','lteq'] %}validator.expect_column_pair_values_a_to_be_greater_than_b(column_A=\"{{column2}}\", column_B=\"{{column}}\", or_equal={{ 'True' if rowOp == 'lteq' else 'False' }}, mostly={{mostly}}{{gxFilter}})  # columns swapped: a {{rowOp}} b is b gt a{% else %}# NOT EXPRESSIBLE: no Great Expectations column-pair expectation for '{{rowOp}}' ({{column}} {{rowSqlOp}} {{column2}}){% endif %}" .

#### RowExpressionRate — an engine-syntax predicate per record ####
tmpl:dbt_rowexpr tmpl:engine "dbt" ; tmpl:metric dqvp:RowExpressionRate ;
  tmpl:body "-- {{checkId}}\nwith m as (select 100.0*count(*) filter (where {{rowExpression}})/nullif(count(*),0) as r from {{dbtSource}}{{sqlFilter}})\nselect r from m where not (r {{sqlOp}} {{threshold}})" .
tmpl:soda_rowexpr tmpl:engine "sodacl" ; tmpl:metric dqvp:RowExpressionRate ;
  tmpl:body "  - rowexpr_{{checkId}} {{sqlOp}} {{threshold}}:\n      name: {{checkId}}\n      rowexpr_{{checkId}} query: |\n        SELECT 100.0*COUNT(*) FILTER (WHERE {{rowExpression}})/NULLIF(COUNT(*),0) FROM {{sourceTable}}" .
tmpl:deequ_rowexpr tmpl:engine "deequ" ; tmpl:metric dqvp:RowExpressionRate ;
  tmpl:body "    .satisfies(\"{{rowExpression}}\", \"{{checkId}}\", lambda x: x {{pyOp}} {{mostly}})  # {{checkId}}{{deequNote}}" .
tmpl:gx_rowexpr tmpl:engine "gx" ; tmpl:metric dqvp:RowExpressionRate ;
  tmpl:body "# NOT EXPRESSIBLE: Great Expectations has no free-form row-expression expectation ({{rowExpression}})" .
