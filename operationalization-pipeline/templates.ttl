@prefix tmpl: <https://feed-upc.github.io/DQVP-position/tmpl#> .
@prefix dqvp: <https://feed-upc.github.io/DQVP-position/dqvp.ttl#> .

# Code templates as graph data (Jinja). The plan stays technology-agnostic;
# templates own engine syntax. The filter clause is computed once by the binder
# (honouring operator + value sets) and injected as {{gxFilter}} /
# {{sqlFilter}} / {{sodaFilter}}. One generic binder renders any (engine, metric).

#### Great Expectations ####
tmpl:gx_nn tmpl:engine "gx" ; tmpl:metric dqvp:NonNullRate ;
  tmpl:body "validator.expect_column_values_to_not_be_null(column=\"{{column}}\", mostly={{mostly}}{{gxFilter}}){% if groupColumn %}  # NOT EXPRESSIBLE: per-group evaluation over {{groupColumn}}; this checks the aggregate{% endif %}" .
tmpl:gx_rc tmpl:engine "gx" ; tmpl:metric dqvp:ReferenceConformance ;
  tmpl:body "validator.expect_column_values_to_be_in_set(column=\"{{column}}\", value_set=CODE_LIST, mostly={{mostly}}{{gxFilter}})" .
tmpl:gx_nr tmpl:engine "gx" ; tmpl:metric dqvp:NullRate ;
  tmpl:body "validator.expect_column_values_to_be_null(column=\"{{column}}\"{{gxFilter}})" .

#### dbt singular tests ({% raw %} guards dbt's own {{ source }}) ####
tmpl:dbt_nn tmpl:engine "dbt" ; tmpl:metric dqvp:NonNullRate ;
  tmpl:body "-- {{checkId}}\nwith m as (select {% if groupColumn %}\"{{groupColumn}}\" as g, {% endif %}100.0*count(\"{{column}}\")/nullif(count(*),0) as r from {{dbtSource}}{{sqlFilter}}{% if groupColumn %} group by \"{{groupColumn}}\"{% endif %})\nselect {% if groupColumn %}g, {% endif %}r from m where not (r {{sqlOp}} {{threshold}})" .
tmpl:dbt_rc tmpl:engine "dbt" ; tmpl:metric dqvp:ReferenceConformance ;
  tmpl:body "-- {{checkId}}\nwith m as (select 100.0*count(*) filter (where \"{{column}}\" in (select code from codes))/nullif(count(\"{{column}}\"),0) as r from {{dbtSource}}{{sqlFilter}})\nselect r from m where not (r {{sqlOp}} {{threshold}})" .
tmpl:dbt_nr tmpl:engine "dbt" ; tmpl:metric dqvp:NullRate ;
  tmpl:body "-- {{checkId}}\nwith m as (select 100.0*(count(*)-count(\"{{column}}\"))/nullif(count(*),0) as r from {{dbtSource}}{{sqlFilter}})\nselect r from m where not (r {{sqlOp}} {{threshold}})" .

#### Soda / SodaCL ####
tmpl:soda_nn tmpl:engine "sodacl" ; tmpl:metric dqvp:NonNullRate ;
  tmpl:body "  - missing_percent({{column}}) <= {{complement}}:\n      name: {{checkId}}{{sodaFilter}}{% if groupColumn %}  # NOT EXPRESSIBLE: per-group evaluation over {{groupColumn}}; this checks the aggregate{% endif %}" .
tmpl:soda_rc tmpl:engine "sodacl" ; tmpl:metric dqvp:ReferenceConformance ;
  tmpl:body "  - invalid_percent({{column}}) <= {{complement}}:\n      name: {{checkId}}\n      valid values: __CODES__{{sodaFilter}}" .
tmpl:soda_nr tmpl:engine "sodacl" ; tmpl:metric dqvp:NullRate ;
  tmpl:body "  - missing_percent({{column}}) {{sqlOp}} {{threshold}}:\n      name: {{checkId}}{{sodaFilter}}" .

#### PyDeequ (illustrative) ####
tmpl:deequ_nn tmpl:engine "deequ" ; tmpl:metric dqvp:NonNullRate ;
  tmpl:body "    .hasCompleteness(\"{{column}}\", lambda x: x {{pyOp}} {{mostly}})  # {{checkId}}{{deequNote}}{% if groupColumn %}  # NOT EXPRESSIBLE: per-group evaluation over {{groupColumn}}; this checks the aggregate{% endif %}" .
tmpl:deequ_rc tmpl:engine "deequ" ; tmpl:metric dqvp:ReferenceConformance ;
  tmpl:body "    .isContainedIn(\"{{column}}\", CODE_LIST)  # {{checkId}}{{deequNote}}" .
tmpl:deequ_nr tmpl:engine "deequ" ; tmpl:metric dqvp:NullRate ;
  tmpl:body "    .hasCompleteness(\"{{column}}\", lambda x: x == 0.0)  # {{checkId}}{{deequNote}}" .

# =============================================================================
# LOAD templates — the data-access code, selected per (engine, FORMAT).
# This is the format dimension (after Hmimou et al.'s forType / technology aspect):
# only the Load operation's code depends on the data format; the check code above
# is format-agnostic because it runs over the loaded table.
# =============================================================================
tmpl:load_gx_csv     tmpl:loadEngine "gx"     ; tmpl:loadFormat "csv"     ; tmpl:loadBody "pd.read_csv('{{locator}}'{% if textColumns %}, dtype={ {% for c in textColumns %}'{{c}}': str{% if not loop.last %}, {% endif %}{% endfor %} }{% endif %})" .
tmpl:load_gx_json    tmpl:loadEngine "gx"     ; tmpl:loadFormat "json"    ; tmpl:loadBody "pd.read_json('{{locator}}')" .
tmpl:load_gx_parquet tmpl:loadEngine "gx"     ; tmpl:loadFormat "parquet" ; tmpl:loadBody "pd.read_parquet('{{locator}}')" .

tmpl:load_duck_csv     tmpl:loadEngine "duckdb" ; tmpl:loadFormat "csv"     ; tmpl:loadBody "read_csv_auto('{{locator}}'{% if textColumns %}, types={ {% for c in textColumns %}'{{c}}': 'VARCHAR'{% if not loop.last %}, {% endif %}{% endfor %} }{% endif %})" .
tmpl:load_duck_json    tmpl:loadEngine "duckdb" ; tmpl:loadFormat "json"    ; tmpl:loadBody "read_json_auto('{{locator}}')" .
tmpl:load_duck_parquet tmpl:loadEngine "duckdb" ; tmpl:loadFormat "parquet" ; tmpl:loadBody "read_parquet('{{locator}}')" .

tmpl:load_dbt_csv  tmpl:loadEngine "dbt" ; tmpl:loadFormat "csv"  ; tmpl:loadBody "# dbt source (dbt-duckdb): external_location: read_csv_auto('{{locator}}'{% if textColumns %}, types={ {% for c in textColumns %}'{{c}}': 'VARCHAR'{% if not loop.last %}, {% endif %}{% endfor %} }{% endif %})" .
tmpl:load_dbt_json tmpl:loadEngine "dbt" ; tmpl:loadFormat "json" ; tmpl:loadBody "# dbt source (dbt-duckdb): external_location: read_json_auto('{{locator}}')" .
tmpl:load_dbt_parquet tmpl:loadEngine "dbt" ; tmpl:loadFormat "parquet" ; tmpl:loadBody "# dbt source (dbt-duckdb): external_location: read_parquet('{{locator}}')" .

# =============================================================================
# v0.3 metrics. Grouping ({{groupColumn}}) is handled inside the template with a
# Jinja conditional rather than by a new binder function, so support for it is
# per-(engine, metric) data. Engines with no native per-group evaluation emit an
# explicit note rather than silently checking the aggregate instead.
# =============================================================================

#### UniqueRate ####
tmpl:gx_uq tmpl:engine "gx" ; tmpl:metric dqvp:UniqueRate ;
  tmpl:body "validator.expect_column_values_to_be_unique(column=\"{{column}}\", mostly={{mostly}}{{gxFilter}})" .
tmpl:dbt_uq tmpl:engine "dbt" ; tmpl:metric dqvp:UniqueRate ;
  tmpl:body "-- {{checkId}}\nwith m as (select 100.0*count(distinct \"{{column}}\")/nullif(count(\"{{column}}\"),0) as r from {{dbtSource}}{{sqlFilter}})\nselect r from m where not (r {{sqlOp}} {{threshold}})" .
tmpl:soda_uq tmpl:engine "sodacl" ; tmpl:metric dqvp:UniqueRate ;
  tmpl:body "  - duplicate_percent({{column}}) <= {{complement}}:\n      name: {{checkId}}{{sodaFilter}}" .
tmpl:deequ_uq tmpl:engine "deequ" ; tmpl:metric dqvp:UniqueRate ;
  tmpl:body "    .hasUniqueness(\"{{column}}\", lambda x: x {{pyOp}} {{mostly}})  # {{checkId}}{{deequNote}}" .

#### RowCount — table level, absolute threshold (no column, no percentage) ####
tmpl:gx_rc2 tmpl:engine "gx" ; tmpl:metric dqvp:RowCount ;
  tmpl:body "validator.expect_table_row_count_to_be_between(min_value={{threshold}}){% if groupColumn %}  # NOT EXPRESSIBLE: per-group evaluation over {{groupColumn}}; this checks the aggregate{% endif %}" .
tmpl:dbt_rc2 tmpl:engine "dbt" ; tmpl:metric dqvp:RowCount ;
  tmpl:body "-- {{checkId}}\nwith m as (select {% if groupColumn %}\"{{groupColumn}}\" as g, {% endif %}count(*) as r from {{dbtSource}}{{sqlFilter}}{% if groupColumn %} group by \"{{groupColumn}}\"{% endif %})\nselect {% if groupColumn %}g, {% endif %}r from m where not (r {{sqlOp}} {{threshold}})" .
tmpl:soda_rc2 tmpl:engine "sodacl" ; tmpl:metric dqvp:RowCount ;
  tmpl:body "  - row_count {{sqlOp}} {{threshold}}:\n      name: {{checkId}}{{sodaFilter}}{% if groupColumn %}  # NOT EXPRESSIBLE: per-group evaluation over {{groupColumn}}; this checks the aggregate{% endif %}" .
tmpl:deequ_rc2 tmpl:engine "deequ" ; tmpl:metric dqvp:RowCount ;
  tmpl:body "    .hasSize(lambda x: x {{pyOp}} {{threshold}})  # {{checkId}}{{deequNote}}{% if groupColumn %}  # NOT EXPRESSIBLE: per-group evaluation over {{groupColumn}}; this checks the aggregate{% endif %}" .

#### AttributeAgreementRate — relates two columns of the same record ####
tmpl:gx_ag tmpl:engine "gx" ; tmpl:metric dqvp:AttributeAgreementRate ;
  tmpl:body "validator.expect_column_pair_values_to_be_equal(column_A=\"{{column}}\", column_B=\"{{column2}}\", mostly={{mostly}}{{gxFilter}})" .
tmpl:dbt_ag tmpl:engine "dbt" ; tmpl:metric dqvp:AttributeAgreementRate ;
  tmpl:body "-- {{checkId}}\nwith m as (select {% if groupColumn %}\"{{groupColumn}}\" as g, {% endif %}100.0*count(*) filter (where \"{{column}}\" = \"{{column2}}\")/nullif(count(*),0) as r from {{dbtSource}}{{sqlFilter}}{% if groupColumn %} group by \"{{groupColumn}}\"{% endif %})\nselect {% if groupColumn %}g, {% endif %}r from m where not (r {{sqlOp}} {{threshold}})" .
tmpl:soda_ag tmpl:engine "sodacl" ; tmpl:metric dqvp:AttributeAgreementRate ;
  tmpl:body "  - agreement_{{checkId}} >= {{threshold}}:\n      name: {{checkId}}\n      agreement_{{checkId}} query: |\n        SELECT 100.0*COUNT(*) FILTER (WHERE \"{{column}}\" = \"{{column2}}\")/NULLIF(COUNT(*),0) FROM {{sourceTable}}{{sqlFilter}}" .
tmpl:deequ_ag tmpl:engine "deequ" ; tmpl:metric dqvp:AttributeAgreementRate ;
  tmpl:body "    .satisfies(\"{{column}} = {{column2}}\", \"{{checkId}}\", lambda x: x {{pyOp}} {{mostly}})  # {{checkId}}{{deequNote}}" .

# =============================================================================
# v0.4 row-predicate metrics. The record-level operator arrives as both a local
# name ({{rowOp}}) and a symbol ({{rowSqlOp}}); engines that express only some
# comparisons dispatch on the name and refuse the rest, rather than emitting a
# check that looks right and tests something else.
# =============================================================================

#### RowComparison — target OP compared, per record, then a rate ####
tmpl:dbt_rowcmp tmpl:engine "dbt" ; tmpl:metric dqvp:RowComparison ;
  tmpl:body "-- {{checkId}}\nwith m as (select {% if groupColumn %}\"{{groupColumn}}\" as g, {% endif %}100.0*count(*) filter (where \"{{column}}\" {{rowSqlOp}} \"{{column2}}\")/nullif(count(*) filter (where \"{{column}}\" is not null and \"{{column2}}\" is not null),0) as r from {{dbtSource}}{{sqlFilter}}{% if groupColumn %} group by \"{{groupColumn}}\"{% endif %})\nselect {% if groupColumn %}g, {% endif %}r from m where not (r {{sqlOp}} {{threshold}})" .

tmpl:soda_rowcmp tmpl:engine "sodacl" ; tmpl:metric dqvp:RowComparison ;
  tmpl:body "  - rowcmp_{{checkId}} {{sqlOp}} {{threshold}}:\n      name: {{checkId}}\n      rowcmp_{{checkId}} query: |\n        SELECT 100.0*COUNT(*) FILTER (WHERE \"{{column}}\" {{rowSqlOp}} \"{{column2}}\")/NULLIF(COUNT(*) FILTER (WHERE \"{{column}}\" IS NOT NULL AND \"{{column2}}\" IS NOT NULL),0) FROM {{sourceTable}}{{sqlFilter}}" .

tmpl:deequ_rowcmp tmpl:engine "deequ" ; tmpl:metric dqvp:RowComparison ;
  tmpl:body "    .satisfies(\"{{column}} {{rowSqlOp}} {{column2}}\", \"{{checkId}}\", lambda x: x {{pyOp}} {{mostly}})  # {{checkId}}{{deequNote}}" .

# Great Expectations has a pair expectation for equality and for A-greater-than-B
# (with or_equal). Less-than is the same expectation with the columns swapped.
# There is no pair inequality expectation, so neq is refused.
tmpl:gx_rowcmp tmpl:engine "gx" ; tmpl:metric dqvp:RowComparison ;
  tmpl:body "{% if rowOp == 'eq' %}validator.expect_column_pair_values_to_be_equal(column_A=\"{{column}}\", column_B=\"{{column2}}\", mostly={{mostly}}{{gxFilter}}){% elif rowOp in ['gt','gteq'] %}validator.expect_column_pair_values_a_to_be_greater_than_b(column_A=\"{{column}}\", column_B=\"{{column2}}\", or_equal={{ 'True' if rowOp == 'gteq' else 'False' }}, mostly={{mostly}}{{gxFilter}}){% elif rowOp in ['lt','lteq'] %}validator.expect_column_pair_values_a_to_be_greater_than_b(column_A=\"{{column2}}\", column_B=\"{{column}}\", or_equal={{ 'True' if rowOp == 'lteq' else 'False' }}, mostly={{mostly}}{{gxFilter}})  # columns swapped: a {{rowOp}} b is b gt a{% else %}# NOT EXPRESSIBLE: no Great Expectations column-pair expectation for '{{rowOp}}' ({{column}} {{rowSqlOp}} {{column2}}){% endif %}" .

#### RowExpressionRate — an engine-syntax predicate per record ####
tmpl:dbt_rowexpr tmpl:engine "dbt" ; tmpl:metric dqvp:RowExpressionRate ;
  tmpl:body "-- {{checkId}}\nwith m as (select 100.0*count(*) filter (where {{rowExpression}})/nullif(count(*),0) as r from {{dbtSource}}{{sqlFilter}})\nselect r from m where not (r {{sqlOp}} {{threshold}})" .
tmpl:soda_rowexpr tmpl:engine "sodacl" ; tmpl:metric dqvp:RowExpressionRate ;
  tmpl:body "  - rowexpr_{{checkId}} {{sqlOp}} {{threshold}}:\n      name: {{checkId}}\n      rowexpr_{{checkId}} query: |\n        SELECT 100.0*COUNT(*) FILTER (WHERE {{rowExpression}})/NULLIF(COUNT(*),0) FROM {{sourceTable}}{{sqlFilter}}" .
tmpl:deequ_rowexpr tmpl:engine "deequ" ; tmpl:metric dqvp:RowExpressionRate ;
  tmpl:body "    .satisfies({{rowExpression|pystr}}, \"{{checkId}}\", lambda x: x {{pyOp}} {{mostly}})  # {{checkId}}{{deequNote}}  -- NOTE: the expression is DuckDB SQL; Spark SQL quotes identifiers with backticks" .
tmpl:gx_rowexpr tmpl:engine "gx" ; tmpl:metric dqvp:RowExpressionRate ;
  tmpl:body "# NOT EXPRESSIBLE: Great Expectations has no free-form row-expression expectation ({{rowExpression}})" .

# =============================================================================
# v0.5 schema metrics. Measured over the schema, so no row filter is injected.
# Deequ has no set-of-columns constraint, so it refuses rather than approximating.
# =============================================================================

#### SchemaConformance — the expected attributes are declared ####
tmpl:gx_schema tmpl:engine "gx" ; tmpl:metric dqvp:SchemaConformance ;
  tmpl:body "validator.expect_table_columns_to_match_set(column_set={{gxColumnSet}}, exact_match=False)" .
tmpl:dbt_schema tmpl:engine "dbt" ; tmpl:metric dqvp:SchemaConformance ;
  tmpl:body "-- {{checkId}}\nwith m as (select 100.0*count(*)/{{expectedCount}} as r from (describe {{dbtSource}}) where column_name in ({{sqlColumnList}}))\nselect r from m where not (r {{sqlOp}} {{threshold}})" .
tmpl:soda_schema tmpl:engine "sodacl" ; tmpl:metric dqvp:SchemaConformance ;
  tmpl:body "  - schema:\n      name: {{checkId}}\n      fail:\n        when required column missing: {{sodaColumnList}}" .
tmpl:deequ_schema tmpl:engine "deequ" ; tmpl:metric dqvp:SchemaConformance ;
  tmpl:body "    # NOT EXPRESSIBLE: PyDeequ has no set-of-columns constraint; expected {{sodaColumnList}}  # {{checkId}}" .

#### AttributeTypeConformance — the target attribute has the expected datatype ####
tmpl:gx_dtype tmpl:engine "gx" ; tmpl:metric dqvp:AttributeTypeConformance ;
  tmpl:body "{% if expectedDatatype in ['string','date','dateTime','integer','int','long','decimal','double','float','boolean'] %}validator.expect_column_values_to_be_of_type(column=\"{{column}}\", type_=\"{% if expectedDatatype == 'string' %}str{% elif expectedDatatype in ['date','dateTime'] %}datetime64[ns]{% elif expectedDatatype in ['integer','int','long'] %}int64{% elif expectedDatatype in ['decimal','double','float'] %}float64{% else %}bool{% endif %}\"){% else %}# NOT EXPRESSIBLE: no Great Expectations type for xsd:{{expectedDatatype}}{% endif %}" .
tmpl:dbt_dtype tmpl:engine "dbt" ; tmpl:metric dqvp:AttributeTypeConformance ;
  tmpl:body "-- {{checkId}}\nwith m as (select 100.0*count(*) as r from (describe {{dbtSource}}) where column_name = '{{column}}' and upper(column_type) like '%{{sqlType}}%')\nselect r from m where not (r {{sqlOp}} {{threshold}})" .
tmpl:soda_dtype tmpl:engine "sodacl" ; tmpl:metric dqvp:AttributeTypeConformance ;
  tmpl:body "  - schema:\n      name: {{checkId}}\n      fail:\n        when wrong column type:\n          {{column}}: {{sqlType|lower}}" .
tmpl:deequ_dtype tmpl:engine "deequ" ; tmpl:metric dqvp:AttributeTypeConformance ;
  tmpl:body "    .hasDataType(\"{{column}}\", ConstrainableDataTypes.{% if expectedDatatype == 'string' %}String{% elif expectedDatatype in ['integer','int','long'] %}Integral{% elif expectedDatatype in ['decimal','double','float'] %}Fractional{% elif expectedDatatype == 'boolean' %}Boolean{% else %}String{% endif %})  # {{checkId}}" .

# =============================================================================
# v0.6 baselines. A drift requirement compares a measurement against the asset's
# own history, which needs a metrics store the check can read. Only Deequ has
# one; the other three have no way to express "compared with last time" as a
# declarative check, so they say so.
#
# The reference executor CAN evaluate these, because it holds the provenance
# graph. That asymmetry is the point: this is a class of requirement the
# contract layer expresses and the engines below it mostly cannot.
# =============================================================================
tmpl:deequ_drift tmpl:engine "deequ" ; tmpl:metric dqvp:PriorMeasurement ;
  tmpl:body "    # {{checkId}} — requires a configured MetricsRepository\n    VerificationSuite().onData(df).useRepository(repo).saveOrAppendResult(key)\n      .addAnomalyCheck(AbsoluteChangeStrategy(maxRateDecrease=-{{threshold}}, maxRateIncrease={{threshold}}),\n                       Completeness(\"{{column}}\"))" .
tmpl:gx_drift tmpl:engine "gx" ; tmpl:metric dqvp:PriorMeasurement ;
  tmpl:body "# NOT EXPRESSIBLE: Great Expectations evaluates a batch against declared bounds, not against this asset's previous measurements ({{checkId}})" .
tmpl:soda_drift tmpl:engine "sodacl" ; tmpl:metric dqvp:PriorMeasurement ;
  tmpl:body "  # NOT EXPRESSIBLE: SodaCL change-over-time checks need Soda Cloud; there is no self-contained form ({{checkId}})" .
tmpl:dbt_drift tmpl:engine "dbt" ; tmpl:metric dqvp:PriorMeasurement ;
  tmpl:body "-- NOT EXPRESSIBLE: comparing against previous runs is a snapshot/incremental pipeline pattern in dbt, not a test ({{checkId}})" .

# =============================================================================
# v0.7 cross-asset. SodaCL has a first-class reference check and dbt is a
# subquery; GX validates one batch and PyDeequ one DataFrame, so neither can
# reach a second asset from inside a check.
# =============================================================================
tmpl:dbt_refint tmpl:engine "dbt" ; tmpl:metric dqvp:ReferentialIntegrity ;
  tmpl:body "-- {{checkId}}\nwith m as (select 100.0*count(*) filter (where \"{{column}}\" in (select \"{{referenceColumn}}\" from {{dbtRefSource}}))/nullif(count(*) filter (where \"{{column}}\" is not null),0) as r from {{dbtSource}}{{sqlFilter}})\nselect r from m where not (r {{sqlOp}} {{threshold}})" .
tmpl:soda_refint tmpl:engine "sodacl" ; tmpl:metric dqvp:ReferentialIntegrity ;
  tmpl:body "  - values in ({{column}}) must exist in {{refTable}} ({{referenceColumn}}):\n      name: {{checkId}}" .
tmpl:gx_refint tmpl:engine "gx" ; tmpl:metric dqvp:ReferentialIntegrity ;
  tmpl:body "# NOT EXPRESSIBLE: a Great Expectations suite validates one batch; it cannot read {{refTable}}.{{referenceColumn}} from inside a check ({{checkId}})" .
tmpl:deequ_refint tmpl:engine "deequ" ; tmpl:metric dqvp:ReferentialIntegrity ;
  tmpl:body "    # NOT EXPRESSIBLE: PyDeequ constraints are scoped to one DataFrame; {{refTable}}.{{referenceColumn}} is outside it  # {{checkId}}" .

# =============================================================================
# v0.8 distribution summaries. Each engine has a native form for these, because
# summarising a distribution to a bound is what a data quality check IS - the
# apparent need for vector-valued measurements was a modelling error, not a gap
# in the engines.
# =============================================================================
tmpl:gx_quantile tmpl:engine "gx" ; tmpl:metric dqvp:Quantile ;
  tmpl:body "validator.expect_column_quantile_values_to_be_between(column=\"{{column}}\", quantile_ranges={\"quantiles\": [{{quantile}}], \"value_ranges\": [[None, {{threshold}}]]})" .
tmpl:dbt_quantile tmpl:engine "dbt" ; tmpl:metric dqvp:Quantile ;
  tmpl:body "-- {{checkId}}\nwith m as (select quantile_cont(\"{{column}}\", {{quantile}}) as r from {{dbtSource}}{{sqlFilter}})\nselect r from m where not (r {{sqlOp}} {{threshold}})" .
tmpl:soda_quantile tmpl:engine "sodacl" ; tmpl:metric dqvp:Quantile ;
  tmpl:body "  - percentile({{column}}, {{quantile}}) {{sqlOp}} {{threshold}}:\n      name: {{checkId}}{{sodaFilter}}" .
tmpl:deequ_quantile tmpl:engine "deequ" ; tmpl:metric dqvp:Quantile ;
  tmpl:body "    .hasApproxQuantile(\"{{column}}\", {{quantile}}, lambda x: x {{pyOp}} {{threshold}})  # {{checkId}}{{deequNote}}" .

tmpl:gx_mode tmpl:engine "gx" ; tmpl:metric dqvp:ModeShare ;
  tmpl:body "validator.expect_column_most_common_value_to_be_in_set(column=\"{{column}}\", value_set=ALLOWED_MODE)  # {{checkId}}: GX bounds WHICH value is most common, not its share" .
tmpl:dbt_mode tmpl:engine "dbt" ; tmpl:metric dqvp:ModeShare ;
  tmpl:body "-- {{checkId}}\nwith f as (select count(*) as cnt from {{dbtSource}}{% if sqlFilter %}{{sqlFilter}} and{% else %} where{% endif %} \"{{column}}\" is not null group by \"{{column}}\"),\n     m as (select 100.0*max(cnt)/nullif(sum(cnt),0) as r from f)\nselect r from m where not (r {{sqlOp}} {{threshold}})" .
tmpl:soda_mode tmpl:engine "sodacl" ; tmpl:metric dqvp:ModeShare ;
  tmpl:body "  - mode_share_{{checkId}} {{sqlOp}} {{threshold}}:\n      name: {{checkId}}\n      mode_share_{{checkId}} query: |\n        SELECT 100.0*MAX(cnt)/NULLIF(SUM(cnt),0) FROM (SELECT COUNT(*) AS cnt FROM {{sourceTable}}{% if sqlFilter %}{{sqlFilter}} AND{% else %} WHERE{% endif %} \"{{column}}\" IS NOT NULL GROUP BY \"{{column}}\") s" .
tmpl:deequ_mode tmpl:engine "deequ" ; tmpl:metric dqvp:ModeShare ;
  tmpl:body "    # NOT EXPRESSIBLE: PyDeequ reports most-common values through profiling, not as a constraint on the mode's share  # {{checkId}}" .

#### ShareImbalance — gap between the most and least frequent values (DQRP6, fairness) ####
tmpl:gx_imb tmpl:engine "gx" ; tmpl:metric dqvp:ShareImbalance ;
  tmpl:body "# NOT EXPRESSIBLE: Great Expectations has no expectation on the gap between value shares ({{checkId}})" .
tmpl:dbt_imb tmpl:engine "dbt" ; tmpl:metric dqvp:ShareImbalance ;
  tmpl:body "-- {{checkId}}\nwith f as (select count(*) as cnt from {{dbtSource}}{% if sqlFilter %}{{sqlFilter}} and{% else %} where{% endif %} \"{{column}}\" is not null group by \"{{column}}\"),\n     m as (select 100.0*(max(cnt)-min(cnt))/nullif(sum(cnt),0) as r from f)\nselect r from m where not (r {{sqlOp}} {{threshold}})" .
tmpl:soda_imb tmpl:engine "sodacl" ; tmpl:metric dqvp:ShareImbalance ;
  tmpl:body "  - share_imbalance_{{checkId}} {{sqlOp}} {{threshold}}:\n      name: {{checkId}}\n      share_imbalance_{{checkId}} query: |\n        SELECT 100.0*(MAX(cnt)-MIN(cnt))/NULLIF(SUM(cnt),0) FROM (SELECT COUNT(*) AS cnt FROM {{sourceTable}}{% if sqlFilter %}{{sqlFilter}} AND{% else %} WHERE{% endif %} \"{{column}}\" IS NOT NULL GROUP BY \"{{column}}\") s" .
tmpl:deequ_imb tmpl:engine "deequ" ; tmpl:metric dqvp:ShareImbalance ;
  tmpl:body "    # NOT EXPRESSIBLE: PyDeequ reports value distributions through profiling, not as a constraint on the gap between shares  # {{checkId}}" .

tmpl:gx_expnull tmpl:engine "gx" ; tmpl:metric dqvp:ExplicitNullRate ;
  tmpl:body "validator.expect_column_values_to_not_be_in_set(column=\"{{column}}\", value_set=MISSING_ENCODINGS, mostly={{mostly}}{{gxFilter}})" .
tmpl:dbt_expnull tmpl:engine "dbt" ; tmpl:metric dqvp:ExplicitNullRate ;
  tmpl:body "-- {{checkId}}\nwith m as (select 100.0*count(*) filter (where \"{{column}}\" is null or \"{{column}}\" not in ({{sqlMissingList}}))/nullif(count(*),0) as r from {{dbtSource}}{{sqlFilter}})\nselect r from m where not (r {{sqlOp}} {{threshold}})" .
tmpl:soda_expnull tmpl:engine "sodacl" ; tmpl:metric dqvp:ExplicitNullRate ;
  tmpl:body "  - invalid_percent({{column}}) <= {{complement}}:\n      name: {{checkId}}\n      invalid values: {{sodaMissingList}}{{sodaFilter}}" .
tmpl:deequ_expnull tmpl:engine "deequ" ; tmpl:metric dqvp:ExplicitNullRate ;
  tmpl:body "    .isContainedIn(\"{{column}}\", ALLOWED, lambda x: x {{pyOp}} {{mostly}})  # {{checkId}}: complement of {{sodaMissingList}}{{deequNote}}" .

tmpl:gx_corr tmpl:engine "gx" ; tmpl:metric dqvp:Correlation ;
  tmpl:body "# NOT EXPRESSIBLE: Great Expectations has no column-pair correlation expectation ({{column}}, {{column2}}) — {{checkId}}" .
tmpl:dbt_corr tmpl:engine "dbt" ; tmpl:metric dqvp:Correlation ;
  tmpl:body "-- {{checkId}}\nwith m as (select corr(\"{{column}}\", \"{{column2}}\") as r from {{dbtSource}}{{sqlFilter}})\nselect r from m where not (r {{sqlOp}} {{threshold}})" .
tmpl:soda_corr tmpl:engine "sodacl" ; tmpl:metric dqvp:Correlation ;
  tmpl:body "  - corr_{{checkId}} {{sqlOp}} {{threshold}}:\n      name: {{checkId}}\n      corr_{{checkId}} query: |\n        SELECT CORR(\"{{column}}\", \"{{column2}}\") FROM {{sourceTable}}" .
tmpl:deequ_corr tmpl:engine "deequ" ; tmpl:metric dqvp:Correlation ;
  tmpl:body "    .hasCorrelation(\"{{column}}\", \"{{column2}}\", lambda x: x {{pyOp}} {{threshold}})  # {{checkId}}{{deequNote}}" .
