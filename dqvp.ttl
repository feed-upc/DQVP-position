@prefix dqvp:     <https://feed-upc.github.io/DQVP-position/dqvp.ttl#> .
@prefix odrl:     <http://www.w3.org/ns/odrl/2/> .
@prefix dqv:      <http://www.w3.org/ns/dqv#> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms:  <http://purl.org/dc/terms/> .
@prefix prof:     <http://www.w3.org/ns/dx/prof/> .
@prefix role:     <http://www.w3.org/ns/dx/prof/role/> .
@prefix vann:     <http://purl.org/vocab/vann/> .
@prefix sw:       <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix iso25012: <https://www.iso.org/standard/35736.html#> .

# ------------ Ontology metadata ------------------ #

<https://feed-upc.github.io/DQVP-position/dqvp.ttl>
    a                 owl:Ontology, prof:Profile ;
    prof:isProfileOf  <http://www.w3.org/ns/odrl/2/core> ;
    prof:hasResource  dqvp:dqvp-vocab ;
    dcterms:title     "ODRL Profile for Data Quality Validation (DQVP)"@en ;
    rdfs:label        "ODRL Profile for Data Quality Validation (DQVP)"@en ;
    vann:preferredNamespacePrefix "dqvp" ;
    vann:preferredNamespaceUri     "https://feed-upc.github.io/DQVP-position/dqvp.ttl#"^^xsd:string ;
    owl:versionInfo   "0.2"^^xsd:string ;
    owl:versionIRI    <https://feed-upc.github.io/DQVP-position/dqvp.ttl/0.2> ;
    dcterms:created   "2026-05-15"^^xsd:date ;
    dcterms:modified  "2026-06-16"^^xsd:date ;
    dcterms:creator   "Achraf Hmimou" ;
    dcterms:publisher "Universitat Politècnica de Catalunya" ;
    dcterms:description "A minimal extension of ODRL 2.2 for expressing data-quality constraints inside a conformant policy. A Data Quality Constraint reuses the ODRL leftOperand/operator/rightOperand triple and adds three properties: targetAttribute (the column a metric applies to), referenceStandard (an external standard to validate against) and filter (a row-selection predicate). Quality metrics are an open class grounded in ISO/IEC 25012 dimensions via DQV."@en ;
    rdfs:comment      "RDF vocabulary for the ODRL Profile for Data Quality Validation (DQVP)."@en ;
    dcterms:source    <http://www.w3.org/ns/odrl/2/>, <http://www.w3.org/ns/dqv#> ;
    dcterms:license   <https://creativecommons.org/licenses/by/4.0/> ;
    sw:term_status    "unstable"@en .

dqvp:dqvp-vocab a prof:ResourceDescriptor ;
    prof:hasRole       role:vocabulary ;
    prof:hasArtifact   <https://feed-upc.github.io/DQVP-position/dqvp.ttl> ;
    dcterms:title      "DQVP Turtle vocabulary"@en ;
    dcterms:format     <https://www.iana.org/assignments/media-types/text/turtle> ;
    dcterms:conformsTo <https://www.w3.org/TR/turtle/> .

<https://feed-upc.github.io/DQVP-position/dqvp.ttl#>
    a              skos:Collection ;
    skos:prefLabel "DQVP profile concepts"@en ;
    skos:member    dqvp:QualityPolicy, dqvp:DQConstraint,
                   dqvp:targetAttribute, dqvp:referenceStandard,
                   dqvp:filter, dqvp:RowFilter,
                   dqvp:filterAttribute, dqvp:filterOperator, dqvp:filterValue,
                   dqvp:NonNullRate, dqvp:ReferenceConformance, dqvp:NullRate,
                   dqvp:Completeness, dqvp:Compliance, dqvp:Consistency .

# ------------ Policy and constraint classes ------------------ #

dqvp:QualityPolicy a rdfs:Class, owl:Class, skos:Concept ;
    rdfs:subClassOf  dqv:QualityPolicy ;
    rdfs:isDefinedBy <https://feed-upc.github.io/DQVP-position/dqvp.ttl> ;
    rdfs:label       "Quality Policy"@en ;
    rdfs:comment     "A policy that carries data-quality constraints on an asset."@en ;
    skos:definition  "A policy that carries data-quality constraints on an asset."@en ;
    skos:note        "Co-typed with an ODRL policy subclass (e.g. odrl:Offer or odrl:Agreement) on the same resource, rather than declared rdfs:subClassOf odrl:Policy whose subclasses are mutually disjoint. It specialises dqv:QualityPolicy so that quality terms are negotiated alongside access and usage terms."@en .

dqvp:DQConstraint a rdfs:Class, owl:Class, skos:Concept ;
    rdfs:subClassOf  odrl:Constraint ;
    rdfs:isDefinedBy <https://feed-upc.github.io/DQVP-position/dqvp.ttl> ;
    rdfs:label       "Data Quality Constraint"@en ;
    rdfs:comment     "An odrl:Constraint that asserts a data-quality predicate over the content of an asset."@en ;
    skos:definition  "An odrl:Constraint that asserts a data-quality predicate over the content of an asset."@en ;
    skos:note        "Reuses the native odrl:leftOperand (a quality metric, typed dqv:Metric), odrl:operator and odrl:rightOperand (the threshold on the measured value), and adds dqvp:targetAttribute, dqvp:referenceStandard and dqvp:filter as required by the metric. It is placed as an odrl:constraint on a rule; evaluating it is the task of an ODRL processor, not a contractual action."@en ;
    skos:example '''<https://example.org/c1> a dqvp:DQConstraint ;
    odrl:leftOperand     dqvp:NonNullRate ;
    dqvp:targetAttribute <https://example.org/attr/patientId> ;
    odrl:operator        odrl:gteq ;
    odrl:rightOperand    "99"^^xsd:decimal .'''@en .

# ------------ Constraint properties ------------------ #

dqvp:targetAttribute a rdf:Property, owl:ObjectProperty, skos:Concept ;
    rdfs:isDefinedBy <https://feed-upc.github.io/DQVP-position/dqvp.ttl> ;
    rdfs:domain      dqvp:DQConstraint ;
    rdfs:range       rdfs:Resource ;
    rdfs:label       "target attribute"@en ;
    rdfs:comment     "The attribute (column) of the target asset that a metric is computed over."@en ;
    skos:definition  "The attribute (column) of the target asset that a metric is computed over."@en ;
    skos:note        "An IRI or a column-name string literal. It MAY be stated more than once for multi-column metrics, and is omitted for table-level metrics such as a row count."@en .

dqvp:referenceStandard a rdf:Property, owl:ObjectProperty, skos:Concept ;
    rdfs:isDefinedBy <https://feed-upc.github.io/DQVP-position/dqvp.ttl> ;
    rdfs:domain      dqvp:DQConstraint ;
    rdfs:range       rdfs:Resource ;
    rdfs:label       "reference standard"@en ;
    rdfs:comment     "An external standard or controlled vocabulary that the target attribute's values are validated against."@en ;
    skos:definition  "An external standard or controlled vocabulary that the target attribute's values are validated against."@en ;
    skos:note        "Identified by an IRI, for example ISO 3166 country codes or SNOMED CT. It is used with dqvp:ReferenceConformance, where odrl:rightOperand carries the conformance threshold."@en .

dqvp:filter a rdf:Property, owl:ObjectProperty, skos:Concept ;
    rdfs:isDefinedBy <https://feed-upc.github.io/DQVP-position/dqvp.ttl> ;
    rdfs:domain      dqvp:DQConstraint ;
    rdfs:range       dqvp:RowFilter ;
    rdfs:label       "filter"@en ;
    rdfs:comment     "A row-selection predicate applied before the metric is computed."@en ;
    skos:definition  "A row-selection predicate applied before the metric is computed."@en ;
    skos:note        "Comparable to a SQL WHERE clause. A constraint MAY carry several filters, which are conjunctive."@en ;
    skos:example '''<https://example.org/c3> a dqvp:DQConstraint ;
    odrl:leftOperand     dqvp:NullRate ;
    dqvp:targetAttribute <https://example.org/attr/pregnancyHistory> ;
    dqvp:filter [ a dqvp:RowFilter ;
                  dqvp:filterAttribute <https://example.org/attr/gender> ;
                  dqvp:filterOperator  odrl:eq ;
                  dqvp:filterValue     "male" ] ;
    odrl:operator        odrl:eq ;
    odrl:rightOperand    "100"^^xsd:decimal .'''@en .

dqvp:RowFilter a rdfs:Class, owl:Class, skos:Concept ;
    rdfs:isDefinedBy <https://feed-upc.github.io/DQVP-position/dqvp.ttl> ;
    rdfs:label       "Row Filter"@en ;
    rdfs:comment     "A predicate over one attribute that restricts the rows a check runs on."@en ;
    skos:definition  "A predicate over one attribute that restricts the rows a check runs on, carrying its own attribute, operator and value(s)."@en .

dqvp:filterAttribute a rdf:Property, owl:ObjectProperty, skos:Concept ;
    rdfs:isDefinedBy <https://feed-upc.github.io/DQVP-position/dqvp.ttl> ;
    rdfs:domain      dqvp:RowFilter ;
    rdfs:range       rdfs:Resource ;
    rdfs:label       "filter attribute"@en ;
    rdfs:comment     "The attribute (column) the filter tests."@en ;
    skos:definition  "The attribute (column) the filter tests."@en .

dqvp:filterOperator a rdf:Property, owl:ObjectProperty, skos:Concept ;
    rdfs:isDefinedBy <https://feed-upc.github.io/DQVP-position/dqvp.ttl> ;
    rdfs:domain      dqvp:RowFilter ;
    rdfs:range       rdfs:Resource ;
    rdfs:label       "filter operator"@en ;
    rdfs:comment     "The comparator the filter applies, an odrl:Operator."@en ;
    skos:definition  "The comparator the filter applies, an odrl:Operator (e.g. odrl:eq, odrl:isAnyOf, odrl:gt)."@en ;
    skos:note        "Defaults to odrl:eq when omitted."@en .

dqvp:filterValue a rdf:Property, owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy <https://feed-upc.github.io/DQVP-position/dqvp.ttl> ;
    rdfs:domain      dqvp:RowFilter ;
    rdfs:range       xsd:string ;
    rdfs:label       "filter value"@en ;
    rdfs:comment     "A value the filter attribute is compared against."@en ;
    skos:definition  "A value the filter attribute is compared against."@en ;
    skos:note        "It MAY be repeated for set-membership filters."@en .

# ------------ Quality metrics (open class) ------------------ #

dqvp:NonNullRate a odrl:LeftOperand, dqv:Metric, owl:NamedIndividual, skos:Concept ;
    rdfs:isDefinedBy <https://feed-upc.github.io/DQVP-position/dqvp.ttl> ;
    dqv:inDimension  dqvp:Completeness ;
    rdfs:label       "Non-Null Rate"@en ;
    rdfs:comment     "Percentage of non-null values for the target attribute."@en ;
    skos:definition  "Percentage of non-null values for the target attribute, in the range 0 to 100."@en ;
    skos:note        "Used as an odrl:leftOperand; odrl:rightOperand is a percentage threshold."@en .

dqvp:ReferenceConformance a odrl:LeftOperand, dqv:Metric, owl:NamedIndividual, skos:Concept ;
    rdfs:isDefinedBy <https://feed-upc.github.io/DQVP-position/dqvp.ttl> ;
    dqv:inDimension  dqvp:Compliance ;
    rdfs:label       "Reference Conformance"@en ;
    rdfs:comment     "Percentage of values in the target attribute that conform to a reference standard."@en ;
    skos:definition  "Percentage of values in the target attribute that conform to an external reference standard, in the range 0 to 100."@en ;
    skos:note        "Requires dqvp:referenceStandard; odrl:rightOperand is a percentage threshold."@en .

dqvp:NullRate a odrl:LeftOperand, dqv:Metric, owl:NamedIndividual, skos:Concept ;
    rdfs:isDefinedBy <https://feed-upc.github.io/DQVP-position/dqvp.ttl> ;
    dqv:inDimension  dqvp:Consistency ;
    rdfs:label       "Null Rate"@en ;
    rdfs:comment     "Percentage of null values for the target attribute."@en ;
    skos:definition  "Percentage of null values for the target attribute, optionally over a filtered subset of rows, in the range 0 to 100."@en ;
    skos:note        "The numeric complement of dqvp:NonNullRate; defined separately because it is grounded in the Consistency dimension and expresses 'must be absent' checks. odrl:rightOperand is a percentage threshold."@en .

# ------------ ISO/IEC 25012 dimensions ------------------ #

dqvp:Completeness a dqv:Dimension, skos:Concept ;
    rdfs:isDefinedBy <https://feed-upc.github.io/DQVP-position/dqvp.ttl> ;
    rdfs:label       "Completeness"@en ;
    rdfs:comment     "ISO/IEC 25012 Completeness dimension."@en ;
    skos:definition  "ISO/IEC 25012: degree to which subject data has values for all expected attributes and related entity instances in a specific context of use."@en ;
    rdfs:seeAlso     iso25012: .

dqvp:Compliance a dqv:Dimension, skos:Concept ;
    rdfs:isDefinedBy <https://feed-upc.github.io/DQVP-position/dqvp.ttl> ;
    rdfs:label       "Compliance"@en ;
    rdfs:comment     "ISO/IEC 25012 Compliance dimension."@en ;
    skos:definition  "ISO/IEC 25012: degree to which data has attributes that adhere to standards, conventions or regulations in force in a specific context of use."@en ;
    rdfs:seeAlso     iso25012: .

dqvp:Consistency a dqv:Dimension, skos:Concept ;
    rdfs:isDefinedBy <https://feed-upc.github.io/DQVP-position/dqvp.ttl> ;
    rdfs:label       "Consistency"@en ;
    rdfs:comment     "ISO/IEC 25012 Consistency dimension."@en ;
    skos:definition  "ISO/IEC 25012: degree to which data has attributes that are free from contradiction and are coherent with other data in a specific context of use."@en ;
    rdfs:seeAlso     iso25012: .

# =============================================================================
# v0.3 — constructs required by the expressiveness ladder (see EXPRESSIVENESS.md)
#
# The three original constructs (targetAttribute, referenceStandard, filter)
# resolve the barriers B1-B3 identified in the position paper. Working through
# progressively harder requirements surfaced two further barriers, each of which
# needs exactly one property.
# =============================================================================

# ------------ Additional properties ------------------ #

dqvp:comparedAttribute a rdf:Property, owl:ObjectProperty, skos:Concept ;
    rdfs:isDefinedBy <https://feed-upc.github.io/DQVP-position/dqvp.ttl> ;
    rdfs:domain      dqvp:DQConstraint ;
    rdfs:label       "compared attribute"@en ;
    rdfs:comment     "A second attribute that the target attribute is compared against, record by record."@en ;
    skos:definition  "The attribute against which dqvp:targetAttribute is compared within the same record, for metrics that relate two columns."@en ;
    skos:note        "Resolves the multi-attribute arity barrier. dqvp:targetAttribute names a single column, so an intra-record comparison between two columns - 'the treating hospital's country must match the patient's country of affiliation' - cannot otherwise be stated. Distinct from dqvp:filter, which selects rows rather than relating columns."@en .

dqvp:groupBy a rdf:Property, owl:ObjectProperty, skos:Concept ;
    rdfs:isDefinedBy <https://feed-upc.github.io/DQVP-position/dqvp.ttl> ;
    rdfs:domain      dqvp:DQConstraint ;
    rdfs:label       "group by"@en ;
    rdfs:comment     "An attribute whose distinct values partition the records; the constraint must hold for every partition."@en ;
    skos:definition  "An attribute whose distinct values partition the dataset. The constraint is evaluated once per partition and is satisfied only if it holds for all of them."@en ;
    skos:note        "Resolves the group quantification barrier. Without it a threshold is only ever evaluated over the dataset as a whole, so a requirement that must hold per country, per hospital or per cohort cannot be stated - and an aggregate can satisfy a threshold while individual partitions violate it. Semantics are universal quantification: a single violating partition violates the constraint."@en .

# ------------ Additional metrics ------------------ #

dqvp:UniqueRate a odrl:LeftOperand, dqv:Metric, owl:NamedIndividual, skos:Concept ;
    rdfs:isDefinedBy <https://feed-upc.github.io/DQVP-position/dqvp.ttl> ;
    dqv:inDimension  dqvp:Uniqueness ;
    rdfs:label       "Unique Rate"@en ;
    rdfs:comment     "Percentage of non-null values of the target attribute that occur exactly once."@en ;
    skos:definition  "Percentage of the non-null values of the target attribute that are distinct, in the range 0 to 100."@en ;
    skos:note        "Used as an odrl:leftOperand; odrl:rightOperand is a percentage threshold. Nulls are excluded from both numerator and denominator, so uniqueness and completeness stay independently expressible."@en .

dqvp:RowCount a odrl:LeftOperand, dqv:Metric, owl:NamedIndividual, skos:Concept ;
    rdfs:isDefinedBy <https://feed-upc.github.io/DQVP-position/dqvp.ttl> ;
    dqv:inDimension  dqvp:Completeness ;
    rdfs:label       "Row Count"@en ;
    rdfs:comment     "Number of records in the dataset."@en ;
    skos:definition  "The count of records in the dataset, optionally over a filtered subset of rows. An absolute count, not a percentage."@en ;
    skos:note        "Takes NO dqvp:targetAttribute: it is a property of the dataset rather than of a column, and odrl:rightOperand is an absolute count rather than a percentage. Consumers deriving percentage-shaped render values from the threshold must not do so for this metric."@en .

dqvp:AttributeAgreementRate a odrl:LeftOperand, dqv:Metric, owl:NamedIndividual, skos:Concept ;
    rdfs:isDefinedBy <https://feed-upc.github.io/DQVP-position/dqvp.ttl> ;
    dqv:inDimension  dqvp:Consistency ;
    rdfs:label       "Attribute Agreement Rate"@en ;
    rdfs:comment     "Percentage of records in which the target attribute equals the compared attribute."@en ;
    skos:definition  "Percentage of records in which dqvp:targetAttribute and dqvp:comparedAttribute hold equal values, counted over records where both are non-null, in the range 0 to 100."@en ;
    skos:note        "Requires dqvp:comparedAttribute. Grounded in Consistency: it expresses freedom from contradiction between two attributes of the same record."@en .

# ------------ Additional dimension ------------------ #

dqvp:Uniqueness a dqv:Dimension, skos:Concept ;
    rdfs:isDefinedBy <https://feed-upc.github.io/DQVP-position/dqvp.ttl> ;
    rdfs:label       "Uniqueness"@en ;
    rdfs:comment     "DAMA-DMBOK Uniqueness dimension."@en ;
    skos:definition  "DAMA-DMBOK: no entity instance is recorded more than once, and each real-world entity is represented by exactly one record."@en ;
    skos:note        "Sourced from DAMA-DMBOK rather than ISO/IEC 25012, which has no distinct uniqueness dimension. The catalogue already grounds Validity in DAMA-DMBOK, so metrics are not restricted to a single reference framework."@en .

# =============================================================================
# v0.4 — the row predicate. Splitting the per-row test from the aggregation it
# feeds surfaced a barrier the earlier constructs had hidden.
# =============================================================================

dqvp:rowOperator a rdf:Property, owl:ObjectProperty, skos:Concept ;
    rdfs:isDefinedBy <https://feed-upc.github.io/DQVP-position/dqvp.ttl> ;
    rdfs:domain      dqvp:DQConstraint ;
    rdfs:label       "row operator"@en ;
    rdfs:comment     "The comparison applied within each record, as distinct from the comparison applied to the aggregated measurement."@en ;
    skos:definition  "An ODRL operator evaluated per record between dqvp:targetAttribute and dqvp:comparedAttribute. The record-level result is aggregated, and odrl:operator then compares that aggregate against odrl:rightOperand."@en ;
    skos:note        "Resolves the predicate-threshold conflation barrier. A constraint such as 'the discharge date must not precede the admission date in at least 99% of records' needs two operators - one per record, one on the resulting rate - and odrl:Constraint provides a single odrl:operator slot. Without this property the per-record comparison has to be frozen into the metric, which is why an equality-only metric was needed for each pairwise test."@en .

dqvp:rowExpression a rdf:Property, owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy <https://feed-upc.github.io/DQVP-position/dqvp.ttl> ;
    rdfs:domain      dqvp:DQConstraint ;
    rdfs:label       "row expression"@en ;
    rdfs:comment     "A boolean expression evaluated per record."@en ;
    skos:definition  "A boolean expression over the attributes of a single record, expressed in the surface syntax of the executing engine."@en ;
    skos:note        "An escape hatch for record-level tests that no operator captures. It is deliberately NOT portable - the expression is engine syntax - so a constraint using it is weaker than one using dqvp:rowOperator and should be preferred only where the latter cannot express the test."@en .

dqvp:RowComparison a odrl:LeftOperand, dqv:Metric, owl:NamedIndividual, skos:Concept ;
    rdfs:isDefinedBy <https://feed-upc.github.io/DQVP-position/dqvp.ttl> ;
    dqv:inDimension  dqvp:Consistency ;
    rdfs:label       "Row Comparison Rate"@en ;
    rdfs:comment     "Percentage of records in which the target attribute stands in the given relation to the compared attribute."@en ;
    skos:definition  "Percentage of records, among those where both attributes are non-null, for which dqvp:targetAttribute dqvp:rowOperator dqvp:comparedAttribute holds. In the range 0 to 100."@en ;
    skos:note        "Generalises dqvp:AttributeAgreementRate, which is this metric with dqvp:rowOperator fixed to odrl:eq."@en .

dqvp:RowExpressionRate a odrl:LeftOperand, dqv:Metric, owl:NamedIndividual, skos:Concept ;
    rdfs:isDefinedBy <https://feed-upc.github.io/DQVP-position/dqvp.ttl> ;
    dqv:inDimension  dqvp:Consistency ;
    rdfs:label       "Row Expression Rate"@en ;
    rdfs:comment     "Percentage of records satisfying a boolean expression."@en ;
    skos:definition  "Percentage of records for which dqvp:rowExpression evaluates true, in the range 0 to 100."@en ;
    skos:note        "Requires dqvp:rowExpression, whose contents are engine syntax and therefore not portable across engines."@en .

# =============================================================================
# v0.5 — the schema as a subject of measurement. Everything so far measures
# records; a requirement can also be about the shape of the data rather than its
# contents.
# =============================================================================

dqvp:expectedAttribute a rdf:Property, owl:ObjectProperty, skos:Concept ;
    rdfs:isDefinedBy <https://feed-upc.github.io/DQVP-position/dqvp.ttl> ;
    rdfs:domain      dqvp:DQConstraint ;
    rdfs:label       "expected attribute"@en ;
    rdfs:comment     "An attribute the dataset is required to carry."@en ;
    skos:definition  "An attribute that must be present in the asset's schema. The property MAY be repeated; the measurement is over the set of expected attributes."@en ;
    skos:note        "Distinct from dqvp:targetAttribute, which names the attribute a metric is computed over. This one names an attribute whose mere presence is the requirement."@en .

dqvp:expectedDatatype a rdf:Property, owl:ObjectProperty, skos:Concept ;
    rdfs:isDefinedBy <https://feed-upc.github.io/DQVP-position/dqvp.ttl> ;
    rdfs:domain      dqvp:DQConstraint ;
    rdfs:label       "expected datatype"@en ;
    rdfs:comment     "The datatype the target attribute is required to have."@en ;
    skos:definition  "An XSD datatype that dqvp:targetAttribute must be declared as in the asset's schema."@en ;
    skos:note        "Carried as an XSD IRI so the contract stays engine-neutral; each engine maps it to its own type names, and an engine with no matching type refuses rather than approximating."@en .

dqvp:SchemaConformance a odrl:LeftOperand, dqv:Metric, owl:NamedIndividual, skos:Concept ;
    rdfs:isDefinedBy <https://feed-upc.github.io/DQVP-position/dqvp.ttl> ;
    dqv:inDimension  dqvp:Completeness ;
    rdfs:label       "Schema Conformance"@en ;
    rdfs:comment     "Percentage of the expected attributes that the asset's schema declares."@en ;
    skos:definition  "Percentage of dqvp:expectedAttribute values present in the asset's schema, in the range 0 to 100."@en ;
    skos:note        "Measured over the schema, not the records, so no row filter applies. Grounded in Completeness at the level of expected attributes rather than expected values."@en .

dqvp:AttributeTypeConformance a odrl:LeftOperand, dqv:Metric, owl:NamedIndividual, skos:Concept ;
    rdfs:isDefinedBy <https://feed-upc.github.io/DQVP-position/dqvp.ttl> ;
    dqv:inDimension  dqvp:Compliance ;
    rdfs:label       "Attribute Type Conformance"@en ;
    rdfs:comment     "Whether the target attribute is declared with the expected datatype."@en ;
    skos:definition  "100 if dqvp:targetAttribute is declared as dqvp:expectedDatatype in the asset's schema, 0 otherwise."@en ;
    skos:note        "Expressed on the 0-100 scale rather than as a boolean so it shares the threshold machinery of every other metric; state it as odrl:gteq 100."@en .

# =============================================================================
# v0.6 — the baseline. Every constraint so far compares a measurement to a value
# stated in the contract. Drift and anomaly requirements compare it to the
# asset's own history, which makes the record of past measurements an input
# rather than only an output.
# =============================================================================

dqvp:baseline a rdf:Property, owl:ObjectProperty, skos:Concept ;
    rdfs:isDefinedBy <https://feed-upc.github.io/DQVP-position/dqvp.ttl> ;
    rdfs:domain      dqvp:DQConstraint ;
    rdfs:label       "baseline"@en ;
    rdfs:comment     "A reference the current measurement is compared against, drawn from the asset's measurement history."@en ;
    skos:definition  "A specification of the reference value for a constraint: rather than the literal in odrl:rightOperand, the measurement is compared against previous measurements of the same metric on the same asset."@en ;
    skos:note        "Composes with any scalar metric, in the way dqvp:groupBy does: a metric plus a baseline is a drift requirement. When present, odrl:rightOperand states a tolerance on the deviation rather than a bound on the measurement itself."@en .

dqvp:PriorMeasurement a rdfs:Class, owl:Class, skos:Concept ;
    rdfs:isDefinedBy <https://feed-upc.github.io/DQVP-position/dqvp.ttl> ;
    rdfs:label       "Prior Measurement"@en ;
    rdfs:comment     "A baseline taken from previously recorded measurements of the same metric on the same asset."@en ;
    skos:note        "With dqvp:window n the baseline is the mean of the n most recent measurements; without it, the single most recent."@en .

dqvp:window a rdf:Property, owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy <https://feed-upc.github.io/DQVP-position/dqvp.ttl> ;
    rdfs:domain      dqvp:PriorMeasurement ;
    rdfs:label       "window"@en ;
    rdfs:comment     "How many recent measurements the baseline is drawn from."@en ;
    skos:definition  "The number of most recent recorded measurements averaged to form the baseline."@en .

dqvp:deviation a rdf:Property, owl:ObjectProperty, skos:Concept ;
    rdfs:isDefinedBy <https://feed-upc.github.io/DQVP-position/dqvp.ttl> ;
    rdfs:domain      dqvp:DQConstraint ;
    rdfs:label       "deviation"@en ;
    rdfs:comment     "How the current measurement is compared against the baseline."@en ;
    skos:definition  "The function applied to the measurement and its baseline to produce the value that odrl:operator and odrl:rightOperand then bound."@en .

dqvp:AbsoluteDeviation a owl:NamedIndividual, skos:Concept ;
    rdfs:isDefinedBy <https://feed-upc.github.io/DQVP-position/dqvp.ttl> ;
    rdfs:label       "Absolute Deviation"@en ;
    skos:definition  "The absolute difference between the measurement and its baseline, in the metric's own units."@en .

dqvp:RelativeDeviation a owl:NamedIndividual, skos:Concept ;
    rdfs:isDefinedBy <https://feed-upc.github.io/DQVP-position/dqvp.ttl> ;
    rdfs:label       "Relative Deviation"@en ;
    skos:definition  "The absolute difference between the measurement and its baseline, as a percentage of the baseline."@en .

# =============================================================================
# v0.7 — the reference asset. Every constraint so far is about one asset. A
# referential requirement relates two, which is the first thing that changes the
# shape of the plan rather than adding a parameter to it.
# =============================================================================

dqvp:referenceAsset a rdf:Property, owl:ObjectProperty, skos:Concept ;
    rdfs:isDefinedBy <https://feed-upc.github.io/DQVP-position/dqvp.ttl> ;
    rdfs:domain      dqvp:DQConstraint ;
    rdfs:label       "reference asset"@en ;
    rdfs:comment     "A second asset whose values the target attribute is checked against."@en ;
    skos:definition  "An odrl:Asset, distinct from the rule's odrl:target, that the constraint reads in order to evaluate the target asset."@en ;
    skos:note        "Resolves the cross-asset barrier. The rule's odrl:target remains the asset being validated - the one the requirement is about, and where the check is deployed - while this names what that check must additionally be able to reach. Keeping the two distinct is what preserves the workflow as a deployable unit."@en .

dqvp:referenceAttribute a rdf:Property, owl:ObjectProperty, skos:Concept ;
    rdfs:isDefinedBy <https://feed-upc.github.io/DQVP-position/dqvp.ttl> ;
    rdfs:domain      dqvp:DQConstraint ;
    rdfs:label       "reference attribute"@en ;
    rdfs:comment     "The attribute of the reference asset that the target attribute is matched against."@en ;
    skos:definition  "The attribute within dqvp:referenceAsset whose values dqvp:targetAttribute must be found among."@en .

dqvp:ReferentialIntegrity a odrl:LeftOperand, dqv:Metric, owl:NamedIndividual, skos:Concept ;
    rdfs:isDefinedBy <https://feed-upc.github.io/DQVP-position/dqvp.ttl> ;
    dqv:inDimension  dqvp:Consistency ;
    rdfs:label       "Referential Integrity"@en ;
    rdfs:comment     "Percentage of records whose target attribute value occurs in the reference asset."@en ;
    skos:definition  "Percentage of records, among those where dqvp:targetAttribute is non-null, whose value occurs in dqvp:referenceAttribute of dqvp:referenceAsset. In the range 0 to 100."@en ;
    skos:note        "Requires dqvp:referenceAsset and dqvp:referenceAttribute. Grounded in Consistency: coherence between data held in different places is exactly what ISO/IEC 25012 names there."@en .

# =============================================================================
# v0.8 — distribution-shaped requirements, reduced to scalars.
#
# These look like they need a measured value that is a vector, a ranked set or a
# distribution. They do not. A constraint has to yield a verdict, and a verdict
# is reached by summarising, so the summary belongs in the metric: a named
# quantile, the share held by the most frequent value, the rate of disguised
# nulls, the correlation between two attributes. Each is a scalar, and the
# existing comparison machinery applies unchanged.
# =============================================================================

dqvp:quantile a rdf:Property, owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy <https://feed-upc.github.io/DQVP-position/dqvp.ttl> ;
    rdfs:domain      dqvp:DQConstraint ;
    rdfs:label       "quantile"@en ;
    rdfs:comment     "Which quantile of the target attribute is measured, between 0 and 1."@en ;
    skos:definition  "The quantile of the distribution of dqvp:targetAttribute that the constraint bounds; 0.5 is the median."@en .

dqvp:missingEncoding a rdf:Property, owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy <https://feed-upc.github.io/DQVP-position/dqvp.ttl> ;
    rdfs:domain      dqvp:DQConstraint ;
    rdfs:label       "missing encoding"@en ;
    rdfs:comment     "A literal used in place of a real null, which the requirement forbids."@en ;
    skos:definition  "A value that stands in for absent data instead of a genuine null. MAY be repeated. The metric counts records NOT using any of them."@en ;
    skos:note        "Absence should be represented once, as a null. A column carrying 'N/A', '-1' and an empty string alongside real nulls has four ways of saying nothing, and every downstream completeness measurement is wrong by however many it misses."@en .

dqvp:Quantile a odrl:LeftOperand, dqv:Metric, owl:NamedIndividual, skos:Concept ;
    rdfs:isDefinedBy <https://feed-upc.github.io/DQVP-position/dqvp.ttl> ;
    dqv:inDimension  dqvp:Accuracy ;
    rdfs:label       "Quantile"@en ;
    rdfs:comment     "The value at a named quantile of the target attribute."@en ;
    skos:definition  "The value below which the given fraction of non-null values of dqvp:targetAttribute falls. Reported in the attribute's own units, not as a percentage."@en ;
    skos:note        "Requires dqvp:quantile. The distribution is summarised at the point the requirement is actually about, rather than compared wholesale."@en .

dqvp:ModeShare a odrl:LeftOperand, dqv:Metric, owl:NamedIndividual, skos:Concept ;
    rdfs:isDefinedBy <https://feed-upc.github.io/DQVP-position/dqvp.ttl> ;
    dqv:inDimension  dqvp:Consistency ;
    rdfs:label       "Mode Share"@en ;
    rdfs:comment     "Percentage of non-null records taking the most frequent value."@en ;
    skos:definition  "The share of non-null records held by the most common value of dqvp:targetAttribute, in the range 0 to 100."@en ;
    skos:note        "The usual reason to look at most-common values: a single value dominating a column signals a stuck feed, a default that was never overwritten, or a class imbalance."@en .

dqvp:ExplicitNullRate a odrl:LeftOperand, dqv:Metric, owl:NamedIndividual, skos:Concept ;
    rdfs:isDefinedBy <https://feed-upc.github.io/DQVP-position/dqvp.ttl> ;
    dqv:inDimension  dqvp:Consistency ;
    rdfs:label       "Explicit Null Rate"@en ;
    rdfs:comment     "Percentage of records that do not disguise absence behind a placeholder value."@en ;
    skos:definition  "Percentage of records where dqvp:targetAttribute is either a genuine null or a value that is not among the declared dqvp:missingEncoding literals, in the range 0 to 100."@en ;
    skos:note        "Requires at least one dqvp:missingEncoding."@en .

dqvp:Correlation a odrl:LeftOperand, dqv:Metric, owl:NamedIndividual, skos:Concept ;
    rdfs:isDefinedBy <https://feed-upc.github.io/DQVP-position/dqvp.ttl> ;
    dqv:inDimension  dqvp:Consistency ;
    rdfs:label       "Correlation"@en ;
    rdfs:comment     "Pearson correlation between the target attribute and the compared attribute."@en ;
    skos:definition  "The Pearson product-moment correlation between dqvp:targetAttribute and dqvp:comparedAttribute over records where both are non-null. In the range -1 to 1."@en ;
    skos:note        "A pairwise correlation is a scalar; only a correlation MATRIX over all attributes is not, and no requirement is stated over a whole matrix."@en .

dqvp:Accuracy a dqv:Dimension, skos:Concept ;
    rdfs:isDefinedBy <https://feed-upc.github.io/DQVP-position/dqvp.ttl> ;
    rdfs:label       "Accuracy"@en ;
    rdfs:comment     "ISO/IEC 25012 Accuracy dimension."@en ;
    skos:definition  "ISO/IEC 25012: degree to which data has attributes that correctly represent the true value of the intended attribute of a concept or event in a specific context of use."@en ;
    rdfs:seeAlso     iso25012: .
